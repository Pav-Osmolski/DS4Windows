<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DS4WinWPF.DS4Forms.Converters"
                    xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit">
    <local:ChangelogImageLimitConverter x:Key="ChangelogImageLimit" />
    <Style x:Key="ChangelogDocumentStyle" TargetType="FlowDocument">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundColor}" />
        <Setter Property="PagePadding" Value="20,8,20,24" />
        <Setter Property="ColumnWidth" Value="Infinity" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="LineHeight" Value="22" />
        <Style.Resources>
            <Style TargetType="Paragraph">
                <Setter Property="Margin" Value="0,0,0,12" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Heading1">
                        <Setter Property="FontSize" Value="26" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Margin" Value="0,28,0,14" />
                    </Trigger>
                    <Trigger Property="Tag" Value="Heading2">
                        <Setter Property="FontSize" Value="22" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Margin" Value="0,28,0,12" />
                    </Trigger>
                    <Trigger Property="Tag" Value="Heading3">
                        <Setter Property="FontSize" Value="18" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Margin" Value="0,20,0,10" />
                    </Trigger>
                    <Trigger Property="Tag" Value="Heading4">
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Margin" Value="0,16,0,8" />
                    </Trigger>
                    <Trigger Property="Tag" Value="CodeBlock">
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
                        <Setter Property="Padding" Value="12" />
                    </Trigger>
                    <Trigger Property="Tag" Value="Note">
                        <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                        <Setter Property="Padding" Value="12,8" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="List">
                <Setter Property="Margin" Value="0,4,0,16" />
                <Setter Property="Padding" Value="24,0,0,0" />
                <Setter Property="MarkerStyle" Value="Disc" />
            </Style>
            <Style TargetType="ListItem"><Setter Property="Margin" Value="0,0,0,4" /></Style>
            <Style TargetType="Section">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Blockquote">
                        <Setter Property="Margin" Value="0,8,0,16" />
                        <Setter Property="Padding" Value="12,4" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Style>
            <Style TargetType="Run">
                <Style.Triggers><Trigger Property="Tag" Value="CodeSpan">
                    <Setter Property="FontFamily" Value="Consolas" />
                    <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
                </Trigger></Style.Triggers>
            </Style>
            <Style TargetType="Span">
                <Style.Triggers><Trigger Property="Tag" Value="CodeSpan">
                    <Setter Property="FontFamily" Value="Consolas" />
                    <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
                </Trigger></Style.Triggers>
            </Style>
            <Style TargetType="Image">
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="StretchDirection" Value="DownOnly" />
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=FlowDocumentScrollViewer}, Converter={StaticResource ChangelogImageLimit}, ConverterParameter=Width}" />
                <Setter Property="MaxHeight" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=FlowDocumentScrollViewer}, Converter={StaticResource ChangelogImageLimit}, ConverterParameter=Height}" />
            </Style>
            <Style TargetType="Table">
                <Setter Property="Margin" Value="0,8,0,20" />
                <Setter Property="CellSpacing" Value="0" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            </Style>
            <Style TargetType="TableCell">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                <Setter Property="BorderThickness" Value="0.5" />
            </Style>
            <Style TargetType="TableRowGroup">
                <Style.Triggers><Trigger Property="Tag" Value="TableHeader">
                    <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger></Style.Triggers>
            </Style>
            <Style TargetType="TableRow">
                <Style.Triggers><Trigger Property="Tag" Value="EvenTableRow">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
                </Trigger></Style.Triggers>
            </Style>
            <Style TargetType="BlockUIContainer"><Setter Property="Margin" Value="0,16,0,20" /></Style>
            <Style TargetType="avalon:TextEditor">
                <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            </Style>
        </Style.Resources>
    </Style>
</ResourceDictionary>
