<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DS4WinWPF.DS4Forms.Themes" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PopupScrollViewerStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="AppPopupSurfaceStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="AppMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource BorderColor}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AppMenuItemStyle" TargetType="MenuItem">
        <Style.Resources>
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource AppMenuSeparatorStyle}"/>
        </Style.Resources>
        <Setter Property="local:MenuItemInteraction.Enabled" Value="True"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid x:Name="MenuRoot" SnapsToDevicePixels="True">
                        <VisualStateManager.CustomVisualStateManager>
                            <local:DisclosureVisualStateManager/>
                        </VisualStateManager.CustomVisualStateManager>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="MenuHoverStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.11"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="MenuNormal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MenuHovered">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MenuPressStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.11"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="MenuReleased">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MenuPress" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MenuPressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MenuPress" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="MenuSurface" CornerRadius="4" Background="{TemplateBinding Background}"/>
                        <Border x:Name="MenuHover" Opacity="0" CornerRadius="4" Background="{DynamicResource DisclosureHoverColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>
                        <Border x:Name="MenuPress" Opacity="0" CornerRadius="4" Background="{DynamicResource AccentColor}"/>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox x:Name="MenuIcon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <ContentPresenter ContentSource="Icon"/>
                            </Viewbox>
                            <Path x:Name="MenuCheck" Visibility="Hidden" Width="12" Height="10" Data="M 1,5 L 4,8 L 11,1" Stretch="Uniform" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.6" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="MenuHeader" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource MutedForegroundColor}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <Path x:Name="SubmenuArrow" Grid.Column="3" Visibility="Collapsed" Width="7" Height="11" Margin="12,0,0,0" Stretch="Uniform" Data="M 1,1 L 5,5 L 1,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                        </Grid>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Right" HorizontalOffset="4" IsOpen="{Binding IsSubmenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
                            <Border Style="{StaticResource AppPopupSurfaceStyle}">
                                <ScrollViewer Style="{StaticResource AppPopupScrollViewerStyle}" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="MenuCheck" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="MenuIcon" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource NavigationSelectionColor}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="local:MenuItemInteraction.Pressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundColor}"/>
                            <Setter TargetName="MenuCheck" Property="Stroke" Value="{DynamicResource AccentForegroundColor}"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="Gesture" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Left"/>
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-4"/>
                            <Setter TargetName="SubmenuArrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="0"/>
                            <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AppContextMenuStyle" TargetType="ContextMenu">
        <Style.Resources>
            <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItemStyle}"/>
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource AppMenuSeparatorStyle}"/>
        </Style.Resources>
        <Setter Property="local:PopupTheme.Synchronize" Value="True"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="PopupSurface" Style="{StaticResource AppPopupSurfaceStyle}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ScrollViewer Style="{StaticResource AppPopupScrollViewerStyle}" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AppPopupCommandStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CommandSurface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CommandSurface" Property="Background" Value="{DynamicResource DisclosureHoverColor}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CommandSurface" Property="Background" Value="{DynamicResource DisclosureHoverColor}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CommandSurface" Property="Background" Value="{DynamicResource AccentColor}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The left action uses secondary-button colours, with only its outside corners rounded. -->
    <Style x:Key="AppSplitActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" CornerRadius="5,0,0,5">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource RaisedBackgroundColor}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource NavigationSelectionColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AppMenuToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ArrowWell" Background="{TemplateBinding Background}" CornerRadius="4">
                        <VisualStateManager.CustomVisualStateManager>
                            <local:DisclosureVisualStateManager/>
                        </VisualStateManager.CustomVisualStateManager>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="ArrowFrame" Width="17" Height="17" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform/>
                            </Grid.RenderTransform>
                            <Path x:Name="Arrow" Data="M 4,6 L 8.5,10.5 L 13,6" Stroke="{DynamicResource MutedForegroundColor}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ArrowWell" Property="Background" Value="{DynamicResource NavigationSelectionColor}"/>
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentColor}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ArrowWell" Property="Background" Value="{DynamicResource NavigationSelectionColor}"/>
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentColor}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ArrowWell" Property="Background" Value="{DynamicResource AccentColor}"/>
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource DisclosureActiveGlyphColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AppSplitButtonStyle" TargetType="xctk:SplitButton">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="xctk:SplitButton">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                        <Grid Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PART_ActionButton" Style="{StaticResource AppSplitActionButtonStyle}" MinHeight="0" Padding="6,3" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <ToggleButton x:Name="PART_ToggleButton" Grid.Column="1" Margin="4" Style="{StaticResource AppMenuToggleStyle}" IsChecked="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <!-- Paint the outline last so neither half can obscure its antialiased inner edge. -->
                        <Border x:Name="SplitSurface" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" StaysOpen="False" IsOpen="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Placement="{TemplateBinding DropDownPosition}" VerticalOffset="4">
                            <Border Style="{StaticResource AppPopupSurfaceStyle}" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer Style="{StaticResource AppPopupScrollViewerStyle}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding DropDownContent}"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SplitSurface" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="SplitSurface" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
