<Window x:Class="DS4WinWPF.DS4Forms.ControllerInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="820" Height="740" MinWidth="640" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{DynamicResource WindowStyle}"
        Background="{DynamicResource SurfaceBackgroundColor}" Foreground="{DynamicResource ForegroundColor}">
    <Window.Resources>
        <DataTemplate x:Key="InfoPaneTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,14,0">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource MutedForegroundColor}"/>
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,3">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,4,16,4"
                                                                   Foreground="{DynamicResource MutedForegroundColor}"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{Binding Name}"
                                                                 BorderThickness="0" Padding="0,4" Background="Transparent"
                                                                 Foreground="{DynamicResource ForegroundColor}" TextWrapping="Wrap"
                                                                 VerticalAlignment="Top"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock x:Name="heading" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="controllerName" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}"/>
        </StackPanel>
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="statusText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="refreshButton" Click="Refresh_Click" Style="{DynamicResource BridgeSecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button x:Name="copyButton" Click="Copy_Click" Style="{DynamicResource BridgeSecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button x:Name="closeButton" Click="Close_Click" IsCancel="True" Style="{DynamicResource BridgeSecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>
        <TabControl x:Name="infoTabs">
            <TabItem x:Name="physicalTab"><ContentControl Content="{Binding Physical}" ContentTemplate="{StaticResource InfoPaneTemplate}"/></TabItem>
            <TabItem x:Name="emulatedTab"><ContentControl Content="{Binding Emulated}" ContentTemplate="{StaticResource InfoPaneTemplate}"/></TabItem>
        </TabControl>
    </DockPanel>
</Window>
