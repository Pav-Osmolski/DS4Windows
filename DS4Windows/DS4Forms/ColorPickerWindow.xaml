<Window x:Class="DS4WinWPF.DS4Forms.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Width="440" Height="570" MinWidth="400" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{DynamicResource WindowStyle}"
        Background="{DynamicResource SurfaceBackgroundColor}" Foreground="{DynamicResource ForegroundColor}">
    <DockPanel Margin="20">
        <Button x:Name="closeButton" DockPanel.Dock="Bottom" HorizontalAlignment="Right" MinWidth="96"
                Margin="0,16,0,0" Style="{DynamicResource BridgePrimaryButtonStyle}" Click="Close_Click"/>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="hint" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedForegroundColor}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <xctk:ColorCanvas x:Name="colorPicker" SelectedColorChanged="ColorPicker_SelectedColorChanged"
                                  UsingAlphaChannel="False" Foreground="{DynamicResource ForegroundColor}">
                    <xctk:ColorCanvas.Template>
                        <ControlTemplate TargetType="xctk:ColorCanvas">
                            <StackPanel>
                                <Grid Height="150">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                                      <Grid x:Name="PaletteHost">
                                        <Canvas x:Name="PART_ColorShadingCanvas" Width="{Binding ActualWidth, ElementName=PaletteHost}" Height="148" Background="Transparent" ClipToBounds="True">
                                            <Rectangle Width="{Binding ActualWidth, ElementName=PART_ColorShadingCanvas}" Height="148">
                                                <Rectangle.Fill><SolidColorBrush Color="{Binding SelectedColor, ElementName=PART_SpectrumSlider}"/></Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle Width="{Binding ActualWidth, ElementName=PART_ColorShadingCanvas}" Height="148">
                                                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle Width="{Binding ActualWidth, ElementName=PART_ColorShadingCanvas}" Height="148">
                                                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                            </Rectangle>
                                            <Canvas x:Name="PART_ColorShadeSelector" Width="10" Height="10" IsHitTestVisible="False">
                                                <Ellipse Width="10" Height="10" Stroke="Black" StrokeThickness="3"/>
                                                <Ellipse Width="8" Height="8" Canvas.Left="1" Canvas.Top="1" Stroke="White" StrokeThickness="2"/>
                                            </Canvas>
                                        </Canvas>
                                      </Grid>
                                    </Border>
                                    <xctk:ColorSpectrumSlider x:Name="PART_SpectrumSlider" Grid.Column="2" Width="24" Height="150"/>
                                </Grid>
                                <Grid Margin="0,12,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Height="36" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                                        <Border.Background><SolidColorBrush Color="{Binding SelectedColor, RelativeSource={RelativeSource TemplatedParent}}"/></Border.Background>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="HEX" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}"/>
                                    <TextBox x:Name="PART_HexadecimalTextBox" Grid.Column="2" MinHeight="36" VerticalContentAlignment="Center"
                                             FontFamily="Consolas" Padding="10,4" MaxLength="9"/>
                                </Grid>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="R" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding R, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <xctk:IntegerUpDown Grid.Column="3" Minimum="0" Maximum="255" FormatString="F0" Height="32" VerticalAlignment="Center"
                                            Value="{Binding R, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="G" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding G, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <xctk:IntegerUpDown Grid.Column="3" Minimum="0" Maximum="255" FormatString="F0" Height="32" VerticalAlignment="Center"
                                            Value="{Binding G, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="B" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding B, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <xctk:IntegerUpDown Grid.Column="3" Minimum="0" Maximum="255" FormatString="F0" Height="32" VerticalAlignment="Center"
                                            Value="{Binding B, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </ControlTemplate>
                    </xctk:ColorCanvas.Template>
                </xctk:ColorCanvas>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
