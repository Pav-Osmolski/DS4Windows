<UserControl x:Class="DS4WinWPF.DS4Forms.AudioHapticsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1040"
             HorizontalAlignment="Left" VerticalAlignment="Stretch"
             Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource ShellViewportWidth}, ConverterParameter=318}"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows">
    <UserControl.Resources>
        <Style x:Key="FeatureCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="FeatureCardHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="18,14" />
        </Style>
        <Style x:Key="FeatureLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource BridgeSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ActivePresetButton" TargetType="Button" BasedOn="{StaticResource BridgePrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ModernToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26">
                            <Border x:Name="Track" CornerRadius="5" Background="{DynamicResource BorderColor}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" />
                            <Border x:Name="Thumb" Width="18" Height="18" Margin="4" CornerRadius="3"
                                    Background="{DynamicResource ForegroundColor}" HorizontalAlignment="Left" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HapticsSlider" TargetType="Slider">
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="34">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="7" CornerRadius="4" Background="{DynamicResource AccentColor}" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="22" Height="22">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="11" Background="{DynamicResource ForegroundColor}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="2" /></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="7" CornerRadius="4" Background="{DynamicResource BorderColor}" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="audioHapticsScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid Margin="0,0,0,16" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <Border Style="{StaticResource FeatureCard}" Padding="14,9"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{lex:Loc Strings:UI_92C1CDFDF4CB9CF6}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <CheckBox x:Name="enabledToggle" Style="{StaticResource ModernToggle}"
                                  Click="EnabledToggle_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource FeatureCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource FeatureCardHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="6"
                                        Background="{DynamicResource RaisedBackgroundColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                               Foreground="{DynamicResource AccentColor}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{lex:Loc Strings:UI_7100F6A2F74F84AE}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{lex:Loc Strings:UI_B09207F3CF78A78B}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="20">
                            <Border Background="{DynamicResource RaisedBackgroundColor}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="18,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="0%" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                    <Slider x:Name="gainSlider" Grid.Column="1" Style="{StaticResource HapticsSlider}"
                                            Minimum="0" Maximum="200" TickFrequency="5"
                                            ValueChanged="GainSlider_ValueChanged" />
                                    <TextBlock x:Name="gainValueText" Grid.Column="2" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,14,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="lowGainButton" Content="{lex:Loc Strings:UI_F793DE205EAD5AC3}" Tag="50" Style="{StaticResource PresetButton}"
                                        Click="GainPreset_Click" />
                                <Button x:Name="mediumGainButton" Grid.Column="2" Content="{lex:Loc Strings:UI_8E588CD187741F1C}" Tag="100"
                                        Style="{StaticResource PresetButton}" Click="GainPreset_Click" />
                                <Button x:Name="highGainButton" Grid.Column="4" Content="{lex:Loc Strings:UI_C4EBC6D4A5832CD9}" Tag="150"
                                        Style="{StaticResource PresetButton}" Click="GainPreset_Click" />
                            </Grid>

                            <TextBlock Text="{lex:Loc Strings:UI_56CCD012FA61DD4B}" Style="{StaticResource FeatureLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="sourceCombo" MinHeight="42"
                                          SelectionChanged="SourceCombo_SelectionChanged"
                                          DisplayMemberPath="DisplayName" />
                                <Button Grid.Column="1" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                        Width="42" Height="42" Margin="8,0,0,0"
                                        ToolTip="{lex:Loc Strings:UI_1BAF753F2B197388}"
                                        Click="RefreshSources_Click" />
                            </Grid>
                            <TextBlock x:Name="sourceScopeHelp"
                                       Text="{lex:Loc Strings:UI_8C8D61C3039A4B8B}"
                                       Margin="0,7,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />

                            <Border Margin="0,12,0,0" Padding="12,10"
                                    Background="{DynamicResource RaisedBackgroundColor}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{lex:Loc Strings:UI_F7494DC007A3874E}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{lex:Loc Strings:UI_E5AFDB36790D61BE}"
                                                   Margin="0,3,0,0" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                    </StackPanel>
                                    <CheckBox x:Name="automaticGameDetectionToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ModernToggle}"
                                              VerticalAlignment="Center"
                                              ToolTip="{lex:Loc Strings:UI_CB2EF7CDCCD67F8B}"
                                              Click="AutomaticGameDetectionToggle_Click" />
                                </Grid>
                            </Border>

                            <Border x:Name="streamAppToSpeakerPanel"
                                    Margin="0,12,0,0" Padding="12,10"
                                    Background="{DynamicResource RaisedBackgroundColor}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1" CornerRadius="5"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{lex:Loc Strings:UI_8A77B384B715EB77}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{lex:Loc Strings:UI_F6B248C8F8278E3F}"
                                                   Margin="0,3,0,0" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                    </StackPanel>
                                    <CheckBox x:Name="streamAppToSpeakerToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ModernToggle}"
                                              VerticalAlignment="Center"
                                              ToolTip="{lex:Loc Strings:UI_63AA15F31116A92D}"
                                              Click="StreamAppToSpeakerToggle_Click" />
                                    <Grid x:Name="streamAppToHeadsetOnlyPanel"
                                          Grid.Row="1" Grid.ColumnSpan="2"
                                          Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{lex:Loc Strings:UI_6E3B4116187DF042}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{lex:Loc Strings:UI_05DABDBD3CBEB671}"
                                                       Margin="0,3,0,0" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedForegroundColor}" />
                                        </StackPanel>
                                        <CheckBox x:Name="streamAppToHeadsetOnlyToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggle}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{lex:Loc Strings:UI_CA3401C35F05E080}"
                                                  Click="StreamAppToHeadsetOnlyToggle_Click" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Text="{lex:Loc Strings:UI_AC6C84ED1369F964}" Style="{StaticResource FeatureLabel}"
                                       Margin="0,15,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="mixModeButton" Content="{lex:Loc Strings:UI_DCE6EB4447EF655F}" MinHeight="40"
                                        Click="MixMode_Click"
                                        ToolTip="{lex:Loc Strings:UI_4B3DA22AF0A9A20F}" />
                                <Button x:Name="replaceModeButton" Grid.Column="1" Content="{lex:Loc Strings:UI_95E154398A4BC009}"
                                        MinHeight="40" Click="ReplaceMode_Click"
                                        ToolTip="{lex:Loc Strings:UI_6E683F3EE32BF629}" />
                            </Grid>
                            <TextBlock x:Name="modeHelpText" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource FeatureCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource FeatureCardHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="6"
                                        Background="{DynamicResource RaisedBackgroundColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                               Foreground="{DynamicResource AccentColor}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{lex:Loc Strings:UI_9061383B8E228EF3}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{lex:Loc Strings:UI_C2394E190A2B0544}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource RaisedBackgroundColor}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc Strings:UI_14109BAE34F1E570}" Style="{StaticResource FeatureLabel}"
                                                   ToolTip="{lex:Loc Strings:UI_AFF4E1FA5E67A574}" />
                                        <ComboBox x:Name="bassFocusCombo" MinHeight="38"
                                                  SelectionChanged="BassFocusCombo_SelectionChanged">
                                            <ComboBoxItem Content="80 Hz" />
                                            <ComboBoxItem Content="160 Hz" />
                                            <ComboBoxItem Content="240 Hz" />
                                            <ComboBoxItem Content="400 Hz" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{lex:Loc Strings:UI_9061383B8E228EF3}" Style="{StaticResource FeatureLabel}"
                                                   ToolTip="{lex:Loc Strings:UI_0CA3A6E7FD1C8060}" />
                                        <ComboBox x:Name="responseCombo" MinHeight="38"
                                                  SelectionChanged="ResponseCombo_SelectionChanged">
                                            <ComboBoxItem Content="{lex:Loc Strings:UI_3EADECFBD53379B9}" />
                                            <ComboBoxItem Content="{lex:Loc Strings:UI_B6EE7B3E8D9C49D8}" />
                                            <ComboBoxItem Content="{lex:Loc Strings:UI_4AD0CC8EC0084946}" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="{lex:Loc Strings:UI_70A5AE4AA40DC35B}" Style="{StaticResource FeatureLabel}"
                                                   ToolTip="{lex:Loc Strings:UI_F08FE5709F5BEB76}" />
                                        <ComboBox x:Name="attackCombo" MinHeight="38"
                                                  SelectionChanged="AttackCombo_SelectionChanged">
                                            <ComboBoxItem Content="{lex:Loc Strings:UI_E03B2E6B52C8FB89}" />
                                            <ComboBoxItem Content="{lex:Loc Strings:UI_24BBF5E512D84C9D}" />
                                            <ComboBoxItem Content="{lex:Loc Strings:UI_F40EFD76D018D7FB}" />
                                            <ComboBoxItem Content="{lex:Loc Strings:UI_36CE9B888B0C2D7B}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="{lex:Loc Strings:UI_9EFB597C915414FD}" Style="{StaticResource FeatureLabel}"
                                                   ToolTip="{lex:Loc Strings:UI_A0A09846F6C64713}" />
                                        <ComboBox x:Name="releaseCombo" MinHeight="38"
                                                  SelectionChanged="ReleaseCombo_SelectionChanged">
                                            <ComboBoxItem Content="{lex:Loc Strings:UI_827DEB019D72780D}" />
                                            <ComboBoxItem Content="{lex:Loc Strings:UI_1E35938EBC875C2A}" />
                                            <ComboBoxItem Content="{lex:Loc Strings:UI_530B094666EB6097}" />
                                            <ComboBoxItem Content="{lex:Loc Strings:UI_A5DD0016FD12E61B}" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Expander Grid.Row="1" Header="{lex:Loc Strings:UI_E6D2DF0198F79332}" Margin="0,16,0,0"
                                      Foreground="{DynamicResource ForegroundColor}">
                                <StackPanel Margin="0,10,0,0">
                                    <CheckBox x:Name="customFiltersToggle" Content="{lex:Loc Strings:UI_DBA1F6F6A6653DAC}"
                                              Click="CustomFiltersToggle_Click" />
                                    <TextBlock Text="{lex:Loc Strings:UI_BF40309DBD0E77EA}"
                                               TextWrapping="Wrap" Margin="0,8,0,12"
                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                    <DockPanel>
                                        <TextBlock Text="{lex:Loc Strings:UI_FAA22CEE68AE363E}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="lowPassValueText" Text="160 Hz" DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Slider x:Name="lowPassSlider" Minimum="40" Maximum="1400" Value="160"
                                            TickFrequency="10" IsSnapToTickEnabled="True"
                                            Style="{StaticResource HapticsSlider}" ValueChanged="FrequencySlider_ValueChanged"
                                            AutomationProperties.Name="Low-pass frequency in Hz" />
                                    <TextBlock Text="{lex:Loc Strings:UI_D56F042DEE02B24C}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" />
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBlock Text="{lex:Loc Strings:UI_C7E889C15C3F0FE3}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="highPassValueText" Text="20 Hz" DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Slider x:Name="highPassSlider" Minimum="0" Maximum="150" Value="20"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            Style="{StaticResource HapticsSlider}" ValueChanged="FrequencySlider_ValueChanged"
                                            AutomationProperties.Name="High-pass frequency in Hz" />
                                    <TextBlock Text="{lex:Loc Strings:UI_D4D99A5879DE972C}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" />
                                    <TextBlock Text="{lex:Loc Strings:UI_B62CE2D79CCCD408}"
                                               TextWrapping="Wrap" Margin="0,12,0,0"
                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                </StackPanel>
                            </Expander>
                            <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                                <Border Style="{StaticResource StatusPill}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="statusDot" Width="8" Height="8"
                                                 Fill="{DynamicResource MutedForegroundColor}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="statusText" Margin="8,0,0,0"
                                                   Text="{lex:Loc Strings:UI_CBEEF937575950AA}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatusPill}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource MutedForegroundColor}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="sourceStatusText" Margin="8,0,0,0"
                                                   Text="{lex:Loc Strings:UI_C14D8013D802D47E}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
