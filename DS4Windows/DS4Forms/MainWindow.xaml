<Window x:Name="mainDS4Window" x:Class="DS4WinWPF.DS4Forms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:DS4WinWPF.DS4Forms.Themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        xmlns:localConverters="clr-namespace:DS4WinWPF.DS4Forms.Converters"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xml:lang="en-US"
        mc:Ignorable="d"
        Title="DS4Windows" Height="760" Width="1180" Closing="MainDS4Window_Closing" Closed="MainDS4Window_Closed" StateChanged="MainDS4Window_StateChanged" SizeChanged="MainDS4Window_SizeChanged" LocationChanged="MainDS4Window_LocationChanged" MinWidth="940" MinHeight="620"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Style="{DynamicResource WindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:ImageLocationPaths x:Key="ImgLocPaths" />
        <localConverters:TrayIconConverter x:Key="TrayIconConverter" />
    </Window.Resources>
    <DockPanel>
        <tb:TaskbarIcon x:Name="notifyIcon" Icon="{Binding IconSource,Mode=OneWay,Converter={StaticResource TrayIconConverter}}" ToolTipText="{Binding TooltipText,Mode=OneWay}" MenuActivation="RightClick" TrayRightMouseUp="NotifyIcon_TrayRightMouseUp" TrayMiddleMouseDown="NotifyIcon_TrayMiddleMouseDown" TrayMouseDoubleClick="NotifyIcon_TrayMouseDoubleClick">
            <!--<tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{lex:Loc Strings:UI_ED077F3D8125D60D}" />
                    <Separator />
                    <MenuItem x:Name="exitMenuItem" Header="{lex:Loc Strings:UI_D17D84A604994B72}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>-->
        </tb:TaskbarIcon>

        <local:AppFooterControl x:Name="footerControl" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" />
        <TabControl x:Name="mainTabCon" DockPanel.Dock="Top" SelectionChanged="MainTabCon_SelectionChanged" Style="{StaticResource BridgeMainTabControlStyle}">
            <TabItem x:Name="overviewTab" Header="{lex:Loc Strings:UI_D4B1EA5708DD5329}" Tag="&#xE80F;" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}" ToolTip="{lex:Loc Strings:UI_A063C90272AC00A9}">
                <DockPanel>
                    <Border x:Name="overviewSaveFailurePanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="24,12,24,0" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{lex:Loc DiscardPendingProfileSaves}" Click="DiscardOverviewProfileSaves_Click" Margin="16,0,0,0" Style="{StaticResource BridgeSecondaryButtonStyle}" />
                            <Button DockPanel.Dock="Right" Content="{lex:Loc RetryUnsavedProfileChanges}" Click="RetryOverviewProfileSaves_Click" Margin="16,0,0,0" Style="{StaticResource BridgeSecondaryButtonStyle}" />
                            <TextBlock Text="{lex:Loc UnsavedProfileChangesNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                <local:ControllerOverviewControl x:Name="controllerOverviewControl"
                                                 EditProfileRequested="ControllerOverview_EditProfileRequested"
                                                 ControllerDetailsRequested="ControllerOverview_ControllerDetailsRequested"
                                                 ControllerInfoRequested="ControllerOverview_ControllerInfoRequested"
                                                 LightbarRequested="ControllerOverview_LightbarRequested"
                                                 DisconnectRequested="ControllerOverview_DisconnectRequested" />
                </DockPanel>
            </TabItem>

            <TabItem x:Name="controllersTab" Header="{lex:Loc Controllers}" Tag="&#xE7FC;" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}" ToolTip="{lex:Loc Strings:UI_39D4E2C148238E2E}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label x:Name="noContLb" Grid.Row="0" Visibility="Hidden" Content="{lex:Loc NoControllersConnected}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <ListView x:Name="controllerLV" Grid.Row="0" ItemsSource="{Binding ControllerCol}" SelectionMode="Single"
                              SelectedIndex="{Binding CurrentIndex, Mode=OneWayToSource}" Margin="0" Padding="8,0,8,0"
                              SelectedItem="{Binding DataContext.SelectedController, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                              ItemContainerStyle="{StaticResource BridgeControllerCardItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="116" Height="72" Margin="0,0,14,0" CornerRadius="5"
                                                Background="{DynamicResource CardBackgroundColor}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="5"
                                                Visibility="{Binding HasControllerArtwork, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Source="{Binding ControllerImageSource}" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="idColumnTxtB" Text="{Binding IdText, Mode=OneWay}"
                                                       ToolTipOpening="IdColumnTxtB_ToolTipOpening" Tag="{Binding DevIndex, Mode=OneTime}"
                                                       FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <TextBlock.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding IdText}" MaxWidth="450" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding TooltipIDText, Mode=OneWay}" />
                                                    </StackPanel>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Image x:Name="contStatusImg" Source="{Binding StatusSource}" Stretch="Uniform"
                                                       Width="18" Height="18" Margin="0,0,6,0"
                                                       ToolTip="{lex:Loc Strings:UI_3DCBECCC92E1910F}"
                                                       MouseRightButtonUp="ContStatusImg_MouseRightButtonUp" Tag="{Binding DevIndex}" />
                                                <Image Source="{Binding ExclusiveSource}" Width="13" Height="13" Margin="0,0,5,0"
                                                       ToolTip="{Binding IsExclusiveText}" />
                                                <TextBlock Text="{Binding IsExclusiveText}" FontSize="11"
                                                           Foreground="{DynamicResource MutedForegroundColor}" />
                                            </StackPanel>
                                            <Button x:Name="joyConCardLinkButton" HorizontalAlignment="Left"
                                                    Margin="0,7,0,0" MinWidth="100" Height="32" Padding="10,3"
                                                    Visibility="{Binding JoyConLinkAction.Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    IsEnabled="{Binding JoyConLinkAction.Enabled}"
                                                    ToolTip="{Binding JoyConLinkAction.ToolTip}" ToolTipService.ShowOnDisabled="True"
                                                    Click="Switch2JoyConCardLinkBtn_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="9" Height="18" CornerRadius="4,1,1,4"
                                                            BorderBrush="{DynamicResource ForegroundColor}" BorderThickness="1.5" />
                                                    <TextBlock Text="ϟ" Foreground="{DynamicResource AccentColor}" Margin="2,0" />
                                                    <Border Width="9" Height="18" CornerRadius="1,4,4,1"
                                                            BorderBrush="{DynamicResource ForegroundColor}" BorderThickness="1.5" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding JoyConLinkAction.Text}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding JoyConLinkAction.IsArmed}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Border Background="{DynamicResource CardBackgroundColor}"
                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                            CornerRadius="3" Padding="10,5" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{lex:Loc Strings:UI_EA67C2BF0A35BD11}" Foreground="{DynamicResource MutedForegroundColor}" />
                                            <TextBlock Text="{Binding BatteryState, Mode=OneWay}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessColor}" />
                                        </StackPanel>
                                    </Border>
<Button x:Name="controllerCardInfoButton" Style="{DynamicResource ControllerInfoButtonStyle}"
                                    HorizontalAlignment="Right" Margin="0,9,0,0" Click="ControllerCardInfo_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{lex:Loc Strings:UI_55026208AB1964FE}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                                    </StackPanel>

                                    <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,15,0,14"
                                               Background="{DynamicResource BorderColor}" />

                                    <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{lex:Loc Strings:UI_81805FBA72EB727E}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,5" />
                                        <ComboBox Grid.Row="1" VerticalAlignment="Center" x:Name="selectProfCombo" theme:InsetComboBox.ShowControllerIcon="True" Style="{StaticResource BridgeProfileComboBoxStyle}"
                                                      HorizontalAlignment="Left"
                                                      ItemsSource="{Binding ProfileListCol}" SelectedIndex="{Binding SelectedIndex}"
                                                      Tag="{Binding DevIndex, Mode=OneTime}"
                                                      Visibility="{Binding PrimaryDevice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                      SelectionChanged="SelectProfCombo_SelectionChanged" KeyDown="SelectProfCombo_KeyDown">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name,Mode=OneWay,FallbackValue=''}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <CheckBox Grid.Row="1" Grid.Column="1" Content="{lex:Loc LinkProfileId}" IsChecked="{Binding LinkedProfile}"
                                                  IsEnabled="{Binding CanLinkProfile}" Margin="12,0,12,0" VerticalAlignment="Center"
                                                  ToolTip="{lex:Loc Strings:UI_CF060D18277AD290}" />
                                        <xctk:SplitButton Grid.Row="1" Grid.Column="2" x:Name="ProfEditSBtn" Content="{lex:Loc Edit}"
                                                          MinWidth="84" Height="34" Margin="0,0,10,0"
                                                          Visibility="{Binding PrimaryDevice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                          Tag="{Binding DevIndex, Mode=OneTime}" Click="ProfEditSBtn_Click" VerticalAlignment="Center">
                                            <xctk:SplitButton.DropDownContent>
                                                <Button Style="{DynamicResource AppPopupCommandStyle}" x:Name="newProfBtn" Content="{lex:Loc NewProfile}" MinWidth="140"
                                                        Tag="{Binding DevIndex, Mode=OneTime}" Click="NewProfBtn_Click" />
                                            </xctk:SplitButton.DropDownContent>
                                        </xctk:SplitButton>
                                        <TextBlock Grid.Column="3" Visibility="{Binding SupportsSwitch2StandaloneHoldMode, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{lex:Loc Strings:UI_F67FC074CB271AEF}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,5" />
                                        <Button Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"
                                                    Visibility="{Binding SupportsSwitch2StandaloneHoldMode, Converter={StaticResource BooleanToVisibilityConverter}}" Width="116" Height="34"
                                                    Content="{Binding Switch2StandaloneHoldModeText, Mode=OneWay}"
                                                    Click="Switch2JoyConHoldModeBtn_Click"
                                                    ToolTip="{Binding Switch2StandaloneHoldModeToolTip}" />
                                        <TextBlock Grid.Column="4" Visibility="{Binding SupportsSwitch2Identification, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{lex:Loc Strings:UI_8B4FBECE28C88A77}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,5" />
                                        <Button Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0"
                                                    Visibility="{Binding SupportsSwitch2Identification, Converter={StaticResource BooleanToVisibilityConverter}}" Width="92" Height="34"
                                                    Content="{lex:Loc Strings:UI_6A4C3A4483B04488}"
                                                    Click="Switch2IdentifyBtn_Click"
                                                    ToolTip="{lex:Loc Strings:UI_9B5A5F90BCE01E23}" />
                                        <TextBlock Grid.Column="5" Text="{lex:Loc Strings:UI_19F3DDCFE1D67DA8}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,5" />
                                        <Button Grid.Row="1" Grid.Column="5" VerticalAlignment="Center" x:Name="LightColorBtn" Width="116" Height="34"
                                                    Background="{Binding LightColor, Mode=OneWay}" BorderBrush="{DynamicResource BorderColor}"
                                                    Tag="{Binding DevIndex, Mode=OneTime}" Click="LightColorBtn_Click"
                                                    ToolTip="{lex:Loc Strings:UI_0F181154D34FDBC2}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border x:Name="switch2JoyConManualPanel" Grid.Row="1"
                            Visibility="Collapsed" Margin="0,12,0,0"
                            Padding="14,12" CornerRadius="5"
                            Background="{DynamicResource CardBackgroundColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Strings:UI_B44A177A03FBFE75}" FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                            <TextBlock x:Name="switch2JoyConManualStatusText"
                                       Text="{lex:Loc Strings:UI_140887E2269A0928}"
                                       Margin="0,4,0,10" TextWrapping="Wrap" />
                            <ItemsControl x:Name="switch2JoyConManualRows">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="candidateCard" MinWidth="230"
                                                Margin="0,0,10,6" Padding="10,8"
                                                CornerRadius="4"
                                                Background="{DynamicResource CardBackgroundColor}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Margin="0,2,8,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Width="114" Height="36"
                                                        Padding="5" Click="Switch2JoyConManualPairBtn_Click"
                                                        ToolTip="{Binding PairButtonToolTip}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="13" Height="25" CornerRadius="6,2,2,6"
                                                                BorderBrush="{DynamicResource ForegroundColor}"
                                                                BorderThickness="1.5" />
                                                        <TextBlock Grid.Column="1" Text="ϟ" FontSize="18"
                                                                   Margin="3,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentColor}" />
                                                        <Border Grid.Column="2" Width="13" Height="25"
                                                                CornerRadius="2,6,6,2"
                                                                BorderBrush="{DynamicResource ForegroundColor}"
                                                                BorderThickness="1.5" />
                                                        <TextBlock Grid.Column="3" Text="{Binding ButtonText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArmed}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="audioHapticsTab" Header="{lex:Loc Strings:UI_7100F6A2F74F84AE}" Tag="&#xE767;" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}" ToolTip="{lex:Loc Strings:UI_07CD2A0D5B736961}">
                <local:AudioHapticsControl x:Name="audioHapticsControl" SettingsChanged="ProfileFeatureControl_SettingsChanged" />
            </TabItem>

            <TabItem x:Name="triggerLabTab" Header="{lex:Loc Strings:UI_4F7722D7B7B04935}" Tag="TriggerPair" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}" ToolTip="{lex:Loc Strings:UI_B6A10B8EF33F7607}">
                <local:TriggerLabControl x:Name="triggerLabControl" SettingsChanged="ProfileFeatureControl_SettingsChanged" />
            </TabItem>

            <TabItem x:Name="profilesTab" Header="{lex:Loc Profiles}" Tag="&#xE8A5;" ToolTip="{lex:Loc Strings:UI_AF5B046D29032A7C}">
                <Grid x:Name="profDockPanel">
                    <ScrollViewer x:Name="profilesBrowserScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0" Padding="0" CanContentScroll="False"
                                  Visibility="{Binding ElementName=profilesBrowserPanel, Path=Visibility}">
                    <Grid x:Name="profilesBrowserPanel" MinHeight="{Binding ActualHeight, ElementName=profilesBrowserScrollViewer}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Button bottom margins add 6 DIP to this 16-DIP gap,
                             matching the content area's 22-DIP top inset. -->
                        <Border x:Name="profOptsToolbar" Background="Transparent" BorderThickness="0"
                                Padding="0" Margin="0,0,0,16">
                            <WrapPanel VerticalAlignment="Center">
                                <Button x:Name="newProfListBtn" Click="NewProfListBtn_Click"
                                        Style="{StaticResource BridgePrimaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{lex:Loc Strings:UI_FCF4F3F4D5F73EF8}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="editProfBtn" MinHeight="{Binding ElementName=newProfListBtn, Path=ActualHeight}" IsEnabled="False" Click="EditProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{lex:Loc Edit}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="dupProfBtn" MinHeight="{Binding ElementName=newProfListBtn, Path=ActualHeight}" IsEnabled="False" Click="DupProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{lex:Loc Duplicate}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="renameProfBtn" MinHeight="{Binding ElementName=newProfListBtn, Path=ActualHeight}" IsEnabled="False" Click="RenameProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{lex:Loc RenameProfile}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="deleteProfBtn" MinHeight="{Binding ElementName=newProfListBtn, Path=ActualHeight}" IsEnabled="False" Click="DeleteProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Foreground="{DynamicResource DangerColor}"
                                        Margin="0,0,16,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{lex:Loc Delete}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="importProfBtn" MinHeight="{Binding ElementName=newProfListBtn, Path=ActualHeight}" Click="ImportProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{lex:Loc Strings:UI_02B3630D80342B2E}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="exportProfBtn" MinHeight="{Binding ElementName=newProfListBtn, Path=ActualHeight}" IsEnabled="False" Click="ExportProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B6;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{lex:Loc Strings:UI_AC909944B8B33F4B}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Border>

                        <local:SettingsStorageControl x:Name="settingsStorageControl" Grid.Row="1" />

                        <Border x:Name="dupBoxBar" Grid.Row="2" Style="{StaticResource BridgeCardStyle}"
                                Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                            <local:DupBox x:Name="dupBox" HorizontalAlignment="Center" />
                        </Border>

                        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Padding="18,14" BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
