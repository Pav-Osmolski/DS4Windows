<UserControl x:Class="DS4WinWPF.DS4Forms.ControllerOverviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:runtime="clr-namespace:DS4Windows"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="940"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Keep converters used by this control local. The dark theme also
             exposes this key, but a fresh install starts with DefaultTheme;
             relying on a theme-specific resource made the main window fail
             during first-run XAML construction. -->
        <xctk:InverseBoolConverter x:Key="InverseBoolConverter" />

        <Style x:Key="OverviewCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="OverviewEyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
        </Style>

        <Style x:Key="OverviewValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="OverviewSpeakerPanelStyle" TargetType="Grid">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsEnabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedControllerSupportsAudio}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverviewInsetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="OverviewSettingsComboBoxStyle" TargetType="ComboBox"
               BasedOn="{StaticResource BridgeProfileComboBoxStyle}">
            <Setter Property="Width" Value="Auto" />
            <!-- The shared template is designed around 42 DIP. Compressing it
                 here clips the lower border/content at fractional DPI. -->
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="OverviewQuickSliderStyle" TargetType="Slider" BasedOn="{StaticResource AppSliderStyle}" />

        <Style x:Key="OverviewToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ToggleTrack" Width="36" Height="20"
                                    HorizontalAlignment="Left" CornerRadius="10"
                                    Background="{DynamicResource BorderColor}">
                                <Ellipse x:Name="ToggleKnob" Width="14" Height="14" Margin="3"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource ForegroundColor}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470" Padding="30">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource OverviewCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedController}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <Border Width="54" Height="54" CornerRadius="27"
                        Background="{DynamicResource RaisedBackgroundColor}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{lex:Loc Strings:UI_DBA25ECB1CC7E4FE}" Margin="0,16,0,5"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{lex:Loc Strings:UI_843B77026782E787}"
                           Foreground="{DynamicResource MutedForegroundColor}" TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,8,6">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedController}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource OverviewCardStyle}" Padding="20" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="152" Height="92" CornerRadius="5" Margin="0,0,20,0"
                                Background="{DynamicResource RaisedBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="7">
                            <Image Source="{Binding SelectedController.ControllerImageSource}"
                                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{lex:Loc Strings:UI_1D39526F5EFFADFE}" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Text="{Binding SelectedController.ControllerDisplayName}"
                                       Margin="0,5,0,3" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundColor}" />
                            <TextBlock Text="{Binding SelectedController.IdText}"
                                       ToolTip="{Binding SelectedController.IdText}"
                                       Foreground="{DynamicResource MutedForegroundColor}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="{DynamicResource RaisedBackgroundColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{lex:Loc Strings:UI_08BE2C7BB5BF7CAC}" Foreground="{DynamicResource MutedForegroundColor}" />
                                        <TextBlock Text="{Binding CurrentProfileName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentColor}"
                                                   MaxWidth="190" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentProfileName}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource RaisedBackgroundColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="3" Padding="8,4">
                                    <TextBlock Text="{Binding SelectedControllerConnection}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="{lex:Loc Strings:UI_EB690390D504C803}" Style="{StaticResource OverviewEyebrowStyle}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding SelectedControllerBattery}" Margin="0,5,0,0"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Right" />
                            <Button x:Name="overviewControllerInfoButton" Style="{DynamicResource ControllerInfoButtonStyle}"
                                    HorizontalAlignment="Right" Margin="0,9,0,0" Click="ControllerInfoBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{lex:Loc Strings:UI_55026208AB1964FE}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="1" Margin="-6,0,-6,8">
                    <Border Style="{StaticResource OverviewCardStyle}" Width="218" MinHeight="112" Margin="6">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Strings:UI_453E643A57D4F5EC}" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Text="{Binding SelectedControllerConnection}" Margin="0,11,0,3"
                                       Style="{StaticResource OverviewValueStyle}" />
                            <TextBlock Text="{lex:Loc Strings:UI_582646A81487A5AD}" Margin="0,5,0,2"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                            <TextBlock Text="{Binding SelectedControllerLatency}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentColor}"
                                       TextWrapping="Wrap"
                                       ToolTip="{lex:Loc Strings:UI_9D82CF2BFF83FCF9}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OverviewCardStyle}" Width="218" MinHeight="112" Margin="6">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Strings:UI_81805FBA72EB727E}" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Text="{Binding CurrentProfileName}" Margin="0,11,0,3"
                                       Style="{StaticResource OverviewValueStyle}" />
                             <TextBlock Text="{Binding ProfileGuidance}"
                                        TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OverviewCardStyle}" Width="218" MinHeight="112" Margin="6">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Strings:UI_F3326952EBDD8103}" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Margin="0,11,0,3" Style="{StaticResource OverviewValueStyle}"
                                       Text="{Binding SelectedOutputControllerName}" />
                             <TextBlock Text="{lex:Loc Strings:UI_93F23D0D0C93A363}"
                                        TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OverviewCardStyle}" Width="218" MinHeight="112" Margin="6">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Strings:UI_461A6F2045908873}" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock x:Name="controllerStartupTitle" Text="{Binding SelectedControllerStartupTitle}"
                                       Margin="0,11,0,3">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OverviewValueStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedControllerIsReady}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedControllerNeedsAttention}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFB020" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedControllerStartupStage}" Value="{x:Static runtime:ControllerStartupStage.ProfileRequired}">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                             <TextBlock Text="{Binding SelectedControllerStartupDetail}"
                                        TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Grid.Row="2" Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,18">
                            <StackPanel x:Name="profileSelectionNotice" Margin="0,0,0,16"
                                        Visibility="{Binding NeedsProfileSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{lex:Loc Strings:UI_18BCA2DAF670B6A1}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{lex:Loc Strings:UI_0F55C369B95D6658}"
                                           TextWrapping="Wrap" Margin="0,5,0,10" Foreground="{DynamicResource MutedForegroundColor}" />
                                <Button x:Name="selectProfileButton" Content="{lex:Loc Strings:UI_D42C2434603D234A}" HorizontalAlignment="Left"
                                        Style="{StaticResource BridgePrimaryButtonStyle}" Click="ControllerDetailsBtn_Click" />
                            </StackPanel>
                            <TextBlock Text="{lex:Loc Strings:UI_FAFBA7D222C9E997}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{lex:Loc Strings:UI_73633F28FF75F010}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>

                        <Grid x:Name="quickProfileControls" Grid.Row="1" IsEnabled="{Binding HasSelectedProfile}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border Style="{StaticResource OverviewInsetCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc Strings:UI_B7A098F1ABCAC8A2}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{lex:Loc Strings:UI_8ED4DCE8B648CE47}"
                                                   Margin="0,3,0,11" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                        <ComboBox x:Name="outputControllerCombo"
                                                  ItemsSource="{Binding OutputControllerChoices}"
                                                  SelectedValuePath="Type"
                                                  SelectedValue="{Binding SelectedOutputController, Mode=OneWay}"
                                                  SelectionChanged="OutputControllerCombo_SelectionChanged"
                                                  DropDownOpened="OutputControllerCombo_DropDownOpened"
                                                  DropDownClosed="OutputControllerCombo_DropDownClosed"
                                                  PreviewKeyDown="OutputControllerCombo_PreviewKeyDown"
                                                  Style="{StaticResource OverviewSettingsComboBoxStyle}">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource BridgeDropDownItemStyle}">
                                                    <Setter Property="Padding" Value="10,8" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{lex:Loc Strings:UI_D072432036B7D428}"
                                                   Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OverviewInsetCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SelectedController.FeedbackControlLabel}"
                                                   FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value, ElementName=overviewHapticStrengthSlider, StringFormat={}{0:0}%}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentColor}" />
                                        <Slider x:Name="overviewHapticStrengthSlider" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,11,0,0"
                                                Style="{StaticResource OverviewQuickSliderStyle}"
                                                Minimum="0" Maximum="100" TickFrequency="1"
                                                Value="{Binding HapticStrengthPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" />
                                    </Grid>
                                </Border>

                                <Border x:Name="managedSpeakerRouteCard" Style="{StaticResource OverviewInsetCardStyle}" Margin="0"
                                        Visibility="{Binding SelectedControllerSupportsAudio, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Style="{StaticResource OverviewSpeakerPanelStyle}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding SelectedController.ControllerAudioHeader}"
                                                   FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SelectedController.ControllerAudioDescription}"
                                                   Margin="0,3,0,13" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                        <StackPanel Grid.Row="2">
                                            <CheckBox Content="{lex:Loc Strings:UI_E0CE522B70470B1D}"
                                                      Style="{StaticResource OverviewToggleStyle}"
                                                      IsChecked="{Binding SpeakerOutputEnabled, Mode=TwoWay}"
                                                      ToolTip="{lex:Loc Strings:UI_C9D4739D7E6FA770}"
                                                      Margin="0,0,0,12" />
                                            <TextBlock Text="{lex:Loc Strings:UI_BDBDB91EB847C4AF}" Margin="0,0,0,7" />
                                            <ComboBox SelectedIndex="{Binding ControllerAudioRoute, Mode=TwoWay}"
                                                      IsEnabled="{Binding SpeakerOutputEnabled}" Margin="0,0,0,13">
                                                <ComboBoxItem Content="{lex:Loc Strings:UI_45EB3D17B6D39E4B}" />
                                                <ComboBoxItem Content="{lex:Loc Strings:UI_6E3B4116187DF042}" />
                                                <ComboBoxItem Content="{lex:Loc Strings:UI_F9F5196A5ACCAE02}" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3">
                                            <TextBlock Text="{lex:Loc Strings:UI_F6479EB15E423313}" Margin="0,0,0,7" FontWeight="SemiBold"
                                                       ToolTip="{lex:Loc Strings:UI_2518864D93F54545}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="controllerAudioSourceCombo"
                                                          ItemsSource="{Binding ControllerAudioSourceChoices}"
                                                          SelectedValuePath="EndpointId"
                                                          SelectedValue="{Binding ControllerAudioSourceId, Mode=OneWay}"
                                                          SelectionChanged="ControllerAudioSourceCombo_SelectionChanged"
                                                          DropDownOpened="ControllerAudioSourceCombo_DropDownOpened"
                                                          DropDownClosed="ControllerAudioSourceCombo_DropDownClosed"
                                                          PreviewKeyDown="ControllerAudioSourceCombo_PreviewKeyDown"
                                                          IsEnabled="{Binding AudioHapticsSpeakerOverrideActive, Converter={StaticResource InverseBoolConverter}}"
                                                          Style="{StaticResource OverviewSettingsComboBoxStyle}"
                                                          ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button x:Name="refreshControllerAudioSourcesButton"
                                                        Grid.Column="1"
                                                        Width="42" Height="42" Margin="8,0,0,0"
                                                        Content="&#xE72C;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="15"
                                                        ToolTip="{lex:Loc Strings:UI_C0BB0BC24A916263}"
                                                        Click="RefreshControllerAudioSources_Click" />
                                            </Grid>
                                        </StackPanel>
                                        <Border Grid.Row="4" Margin="0,10,0,0" Padding="9,7"
                                                CornerRadius="4" Background="#26FFB020"
                                                BorderBrush="#80FFB020" BorderThickness="1"
                                                Visibility="{Binding AudioHapticsSpeakerOverrideActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{lex:Loc Strings:UI_1E197380E1B15FCF}"
                                                       TextWrapping="Wrap" FontSize="11" Foreground="#FFFFC45C" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border x:Name="nativeUsbHeadsetCard" Style="{StaticResource OverviewInsetCardStyle}"
                                        Visibility="{Binding SelectedControllerShowsUsbHeadsetHelp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc Strings:UI_3F6F3681E1836CEE}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{lex:Loc Strings:UI_38CB7E08FF501881}" Margin="0,10,0,10" TextWrapping="Wrap" />
                                        <TextBlock Text="{lex:Loc Strings:UI_5988DDE8CAAC1548}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                        <TextBlock Text="{lex:Loc Strings:UI_6F83DB5E00837CA1}" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" />
                                        <Button Content="{lex:Loc Strings:UI_8747828ECAFC30CE}" HorizontalAlignment="Left" Padding="10,6"
                                                Style="{StaticResource BridgeSecondaryButtonStyle}"
                                                Click="OpenWindowsSoundSettings_Click" ToolTip="{lex:Loc Strings:UI_960D4D84E9E5AA61}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="managedAudioLevelsPanel"
                                            Visibility="{Binding SelectedControllerSupportsAudio, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource OverviewInsetCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc Strings:UI_B9626A4BE2859E41}" FontSize="15" FontWeight="SemiBold" />
                                        <Grid Margin="0,13,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{lex:Loc Strings:UI_45EB3D17B6D39E4B}"
                                                       IsEnabled="{Binding SpeakerOutputEnabled}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value, ElementName=overviewSpeakerVolumeSlider, StringFormat={}{0:0}%}"
                                                       IsEnabled="{Binding SpeakerOutputEnabled}"
                                                       Foreground="{DynamicResource AccentColor}" />
                                            <Slider x:Name="overviewSpeakerVolumeSlider" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,14"
                                                    Style="{StaticResource OverviewQuickSliderStyle}"
                                                    Minimum="0" Maximum="100" TickFrequency="1"
                                                    IsEnabled="{Binding SpeakerOutputEnabled}"
                                                    Value="{Binding SpeakerVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" />
                                            <TextBlock Grid.Row="2" Text="{lex:Loc Strings:UI_7C5DE709279C5A31}"
                                                       IsEnabled="{Binding SpeakerOutputEnabled}"
                                                       ToolTip="{lex:Loc Strings:UI_D63398FCBCB31030}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                       Text="{Binding Value, ElementName=overviewHeadphoneVolumeSlider, StringFormat={}{0:0}%}"
                                                       IsEnabled="{Binding SpeakerOutputEnabled}"
                                                       Foreground="{DynamicResource AccentColor}" />
                                            <Slider x:Name="overviewHeadphoneVolumeSlider" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                                    Style="{StaticResource OverviewQuickSliderStyle}"
                                                    Minimum="0" Maximum="100" TickFrequency="1"
                                                    IsEnabled="{Binding SpeakerOutputEnabled}"
                                                    Value="{Binding HeadphoneVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

