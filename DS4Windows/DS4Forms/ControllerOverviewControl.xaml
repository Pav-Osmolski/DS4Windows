<UserControl x:Class="DS4WinWPF.DS4Forms.ControllerOverviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:runtime="clr-namespace:DS4Windows"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="940"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Keep converters used by this control local. The dark theme also
             exposes this key, but a fresh install starts with DefaultTheme;
             relying on a theme-specific resource made the main window fail
             during first-run XAML construction. -->
        <xctk:InverseBoolConverter x:Key="InverseBoolConverter" />

        <Style x:Key="OverviewCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=compactSpacing}" Value="True">
                    <Setter Property="Padding" Value="10" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverviewEyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
        </Style>

        <Style x:Key="OverviewValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="OverviewSpeakerPanelStyle" TargetType="Grid">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsEnabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedControllerSupportsAudio}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverviewInsetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=compactSpacing}" Value="True">
                    <Setter Property="Padding" Value="10" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverviewSettingsComboBoxStyle" TargetType="ComboBox"
               BasedOn="{StaticResource BridgeProfileComboBoxStyle}">
            <Setter Property="Width" Value="Auto" />
            <!-- The shared template is designed around 42 DIP. Compressing it
                 here clips the lower border/content at fractional DPI. -->
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="OverviewQuickSliderStyle" TargetType="Slider" BasedOn="{StaticResource AppSliderStyle}" />

        <Style x:Key="OverviewToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ToggleTrack" Width="36" Height="20"
                                    HorizontalAlignment="Left" CornerRadius="10"
                                    Background="{DynamicResource BorderColor}">
                                <Ellipse x:Name="ToggleKnob" Width="14" Height="14" Margin="3"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource ForegroundColor}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverviewGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OverviewCardGlyphStyle" TargetType="TextBlock" BasedOn="{StaticResource OverviewGlyphStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        </Style>
        <Style x:Key="OverviewFactIconStyle" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource MutedForegroundColor}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="OverviewFactTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=showFactTitles}" Value="False">
                    <!-- Keep the text's width and line height when hiding titles. -->
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverviewFactStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,24,0" />
            <Setter Property="MinWidth" Value="106" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="OverviewCustomizeStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource ThemeFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="5" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource NavigationSelectionColor}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470" Padding="30">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource OverviewCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedController}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <Border Width="54" Height="54" CornerRadius="27"
                        Background="{DynamicResource RaisedBackgroundColor}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{lex:Loc Strings:UI_DBA25ECB1CC7E4FE}" Margin="0,16,0,5"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{lex:Loc Strings:UI_843B77026782E787}"
                           Foreground="{DynamicResource MutedForegroundColor}" TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="overviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasSelectedController, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="0,0,8,2">
                <Border Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="96" Height="62" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Top"
                                    Background="{DynamicResource RaisedBackgroundColor}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="5">
                                <Image Source="{Binding SelectedController.ControllerImageSource}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,0,12,0">
                                <TextBlock Text="{Binding SelectedControllerNumber}" Style="{StaticResource OverviewEyebrowStyle}" />
                                <TextBlock Text="{Binding SelectedController.ControllerDisplayName}" FontSize="21" FontWeight="SemiBold"
                                           Margin="0,1,0,2" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedController.IdText}" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{lex:Loc Strings:Profile}" Margin="0,0,6,0"
                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                    <TextBlock Text="{Binding CurrentProfileName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ProfileGuidance}" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="185">
                                <Border Background="{DynamicResource RaisedBackgroundColor}" BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1" CornerRadius="12" Padding="9,3" HorizontalAlignment="Right"
                                        ToolTip="{Binding SelectedControllerStartupDetail}">
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{Binding Foreground, ElementName=controllerStartupTitle}" />
                                        <TextBlock x:Name="controllerStartupTitle" Text="{Binding SelectedControllerStartupTitle}"
                                                   Margin="6,0,0,0" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource OverviewValueStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedControllerIsReady}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedControllerNeedsAttention}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerColor}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedControllerStartupStage}" Value="{x:Static runtime:ControllerStartupStage.ProfileRequired}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0"
                                            Background="Transparent" ToolTip="{lex:Loc Strings:OverviewBatteryHelp}">
                                    <Viewbox Width="20" Height="{Binding FontSize, ElementName=overviewBatteryText}"
                                             Margin="0,0,6,0" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                        <Grid Width="23" Height="14">
                                            <Border x:Name="overviewBatteryFill" Width="14" Height="8" CornerRadius="1"
                                                    Margin="3,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding SelectedControllerBatteryIndicator.Fill, FallbackValue=0}" />
                                                </Border.RenderTransform>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessColor}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedControllerBatteryIndicator.IsLow}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource WarningColor}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedControllerBatteryIndicator.IsCritical}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DangerColor}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Path Stroke="{DynamicResource MutedForegroundColor}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M 3,1 H 17 Q 19,1 19,3 V 11 Q 19,13 17,13 H 3 Q 1,13 1,11 V 3 Q 1,1 3,1 Z M 22,5 V 9" />
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock x:Name="overviewBatteryText" Text="{Binding SelectedControllerBattery}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SuccessColor}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding SelectedControllerStartupDetail}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedForegroundColor}"
                                   Visibility="{Binding SelectedControllerNeedsAttention, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <DockPanel Margin="0,12,0,0">
                            <Button x:Name="overviewControllerInfoButton" DockPanel.Dock="Right" Style="{StaticResource BridgeSecondaryButtonStyle}"
                                    Click="ControllerInfoBtn_Click" AutomationProperties.Name="{lex:Loc Strings:UI_55026208AB1964FE}"
                                    VerticalAlignment="Center" MinHeight="30" Padding="10,4" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource OverviewGlyphStyle}" Text="&#xE946;" />
                                    <TextBlock Text="{lex:Loc Strings:UI_55026208AB1964FE}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource OverviewFactStyle}" ToolTip="{lex:Loc Strings:OverviewConnectionHelp}">
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource OverviewFactIconStyle}">
                                                    <Setter Property="Data" Value="M 3,12 H 21 M 17,8 L 21,12 L 17,16 M 7,12 L 12,7 H 15 V 4 H 12 V 7 M 10,12 L 14,16 H 16 M 16,16 A 2,2 0 1 0 20,16 A 2,2 0 1 0 16,16 M 1,12 A 1,1 0 1 0 3,12 A 1,1 0 1 0 1,12" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedController.Device.ConnectionType}" Value="{x:Static runtime:ConnectionType.BT}">
                                                            <Setter Property="Data" Value="M 6,7 L 18,17 L 12,22 V 2 L 18,7 L 6,17" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedController.Device.ConnectionType}" Value="{x:Static runtime:ConnectionType.SONYWA}">
                                                            <Setter Property="Data" Value="M 3,9 Q 12,1 21,9 M 6,13 Q 12,7 18,13 M 9,17 Q 12,14 15,17 M 12,21 H 12.1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock x:Name="overviewConnectionTitle" Text="{lex:Loc Strings:UI_639A40E82B9A96F0}" Style="{StaticResource OverviewFactTitleStyle}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding SelectedControllerConnection}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource OverviewFactStyle}" ToolTip="{lex:Loc Strings:UI_9D82CF2BFF83FCF9}"
                                            Visibility="{Binding IsChecked, ElementName=showInputRate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left" Style="{StaticResource OverviewFactIconStyle}"
                                              Data="M 2,12 H 6 L 9,4 L 14,20 L 17,12 H 22" />
                                        <TextBlock x:Name="overviewInputRateTitle" Text="{lex:Loc Strings:OverviewInputRate}" Style="{StaticResource OverviewFactTitleStyle}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding SelectedControllerLatency}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource OverviewFactStyle}" ToolTip="{lex:Loc Strings:OverviewAccessHelp}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,6,0"
                                                VerticalAlignment="Center" Background="{DynamicResource MutedForegroundColor}">
                                            <Border.OpacityMask>
                                                <ImageBrush ImageSource="{Binding SelectedController.ExclusiveSource}" Stretch="Uniform" />
                                            </Border.OpacityMask>
                                        </Border>
                                        <TextBlock x:Name="overviewAccessTitle" Text="{lex:Loc Strings:OverviewAccess}" Style="{StaticResource OverviewFactTitleStyle}" />
                                    </DockPanel>
                                    <TextBlock x:Name="overviewAccessStatus" Text="{Binding SelectedController.IsExclusiveText}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource OverviewFactStyle}" ToolTip="{lex:Loc Strings:UI_8ED4DCE8B648CE47}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource OverviewGlyphStyle}"
                                                   Text="&#xE7FC;" Foreground="{DynamicResource MutedForegroundColor}" />
                                        <TextBlock x:Name="overviewOutputTitle" Text="{lex:Loc Strings:UI_B7A098F1ABCAC8A2}" Style="{StaticResource OverviewFactTitleStyle}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding SelectedOutputControllerName}" FontWeight="SemiBold" />
                                </StackPanel>
                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="profileSelectionNotice" Margin="0,0,0,16"
                            Visibility="{Binding NeedsProfileSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{lex:Loc Strings:UI_18BCA2DAF670B6A1}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{lex:Loc Strings:UI_0F55C369B95D6658}"
                               TextWrapping="Wrap" Margin="0,5,0,10" Foreground="{DynamicResource MutedForegroundColor}" />
                    <Button x:Name="selectProfileButton" Content="{lex:Loc Strings:UI_D42C2434603D234A}" HorizontalAlignment="Left"
                            Style="{StaticResource BridgePrimaryButtonStyle}" Click="ControllerDetailsBtn_Click" />
                </StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{lex:Loc Strings:UI_FAFBA7D222C9E997}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{lex:Loc Strings:UI_73633F28FF75F010}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundColor}" />
                    </StackPanel>
                    <ToggleButton x:Name="customizeOverviewButton" Grid.Column="1" Margin="12,0,0,0" Padding="10,5" MinHeight="32"
                                  Style="{StaticResource OverviewCustomizeStyle}"
                                  ToolTip="{lex:Loc Strings:OverviewCustomizeHelp}"
                                  VerticalAlignment="Center" AutomationProperties.Name="{lex:Loc Strings:OverviewCustomize}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource OverviewGlyphStyle}" Text="&#xE713;" />
                            <TextBlock Text="{lex:Loc Strings:OverviewCustomize}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="overviewCustomization" Grid.Column="1" AllowsTransparency="True" Placement="Custom" StaysOpen="False"
                           PlacementTarget="{Binding ElementName=customizeOverviewButton}" Opened="OverviewCustomization_Opened"
                           IsOpen="{Binding IsChecked, ElementName=customizeOverviewButton, Mode=TwoWay}">
                        <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource AccentColor}"
                                BorderThickness="1" CornerRadius="6" Padding="14" MinWidth="230" KeyboardNavigation.TabNavigation="Cycle"
                                TextElement.Foreground="{DynamicResource ForegroundColor}"
                                PreviewKeyDown="OverviewCustomization_PreviewKeyDown">
                            <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{lex:Loc Strings:OverviewCustomize}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <CheckBox x:Name="showFeedback" Content="{lex:Loc Strings:OverviewOutputFeedback}" IsChecked="True" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                <CheckBox x:Name="showAudio" Content="{lex:Loc Strings:UI_82DED80528D9A9C1}" IsChecked="True" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                <CheckBox x:Name="showLevels" Content="{lex:Loc Strings:OverviewLevelsProcessing}" IsChecked="True" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                <CheckBox x:Name="showMicrophone" Content="{lex:Loc Strings:UI_186352A881D0550E}" IsChecked="True" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,3,0,8" />
                                <CheckBox x:Name="showInputRate" Content="{lex:Loc Strings:OverviewShowInputRate}" IsChecked="True" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                <CheckBox x:Name="showFactTitles" Content="{lex:Loc Strings:OverviewShowFactTitles}" IsChecked="True" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                <CheckBox x:Name="compactSpacing" Content="{lex:Loc Strings:OverviewCompactSpacing}" IsChecked="False" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,3,0,8" />
                                <CheckBox x:Name="showQuickActions" Content="{lex:Loc Strings:OverviewShowQuickActions}" IsChecked="True" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                <StackPanel Margin="16,0,0,0" IsEnabled="{Binding IsChecked, ElementName=showQuickActions}">
                                <CheckBox x:Name="showEditProfileAction" Content="{lex:Loc Strings:UI_936A2401794924E0}" IsChecked="True" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                <CheckBox x:Name="showDeviceOptionsAction" Content="{lex:Loc Strings:DeviceOptions}" IsChecked="True" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                <CheckBox x:Name="showControlPanelAction" Content="{lex:Loc Strings:ControlPanel}" IsChecked="True" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                <CheckBox x:Name="showLightbarAction" Content="{lex:Loc Strings:Lightbar}" IsChecked="True" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                <CheckBox x:Name="showDisconnectAction" Content="{lex:Loc Strings:UI_ACFC5BE785A9BB3D}" IsChecked="True" Margin="0,0,0,6"
                                          Checked="OverviewLayout_Changed" Unchecked="OverviewLayout_Changed" />
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <Grid x:Name="quickProfileControls" IsEnabled="{Binding HasSelectedProfile}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="overviewSecondaryColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel x:Name="overviewPrimaryCards" Margin="0,0,6,0">
