<Window x:Class="DS4WinWPF.DS4Forms.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
        Title="{lex:Loc Changelog}" Height="650" Width="900" MinHeight="400" MinWidth="520"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterOwner"
        Style="{DynamicResource WindowStyle}" Background="{DynamicResource SurfaceBackgroundColor}"
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ChangelogReaderStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="{lex:Loc Strings:UI_F952FEE736ED2287}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundColor}" />
                <TextBlock Text="{lex:Loc Strings:UI_399DC9EE169ACF55}" Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundColor}" />
            </StackPanel>
        </Border>
        <mdxam:MarkdownScrollViewer x:Name="changelogReader" Grid.Row="1"
                                    Markdown="{Binding Markdown}" Background="{DynamicResource SurfaceBackgroundColor}"
                                    Foreground="{DynamicResource ForegroundColor}" BorderThickness="0"
                                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                    ClickAction="OpenBrowser" IsToolBarVisible="False"
                                    MarkdownStyle="{StaticResource ChangelogDocumentStyle}" />
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                    Visibility="{Binding ShowStatus, Converter={StaticResource BooleanVisibility}}">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" />
            <Button Content="{lex:Loc Strings:UI_D8B8392E2C542950}" Click="RetryBtn_Click" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="16,8"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanVisibility}}" />
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button x:Name="closeBtn" DockPanel.Dock="Right" Content="{lex:Loc Close}" MinWidth="88" Padding="16,7" IsCancel="True" Click="CloseBtn_Click" />
                <TextBlock VerticalAlignment="Center"><Hyperlink Click="ReleasesLink_Click" Foreground="{DynamicResource AccentColor}">View releases on GitHub</Hyperlink></TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
