<Window x:Class="DS4WinWPF.DS4Forms.SwipeProfilesEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        mc:Ignorable="d"
        Title="{lex:Loc Strings:UI_827148F589912A2D}" Height="460" Width="500" MinHeight="350" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{DynamicResource WindowStyle}"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{lex:Loc Strings:UI_0F1679DB641954F9}" Style="{DynamicResource BridgeSectionTitleStyle}" FontSize="22"/>
            <TextBlock Text="{lex:Loc Strings:UI_FFAB65072A87595C}" Style="{DynamicResource BridgeSectionDescriptionStyle}" Margin="0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource BridgeCardStyle}" Margin="0" Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="selectAllBtn" Content="{lex:Loc Strings:UI_D1EC69E64B9609D0}" Click="SelectAllBtn_Click"
                                Margin="0,0,6,0" Style="{DynamicResource BridgeSecondaryButtonStyle}"/>
                        <Button x:Name="clearAllBtn" Content="{lex:Loc Strings:UI_DDCEB7ADFDB8816E}" Click="ClearAllBtn_Click"
                                Style="{DynamicResource BridgeSecondaryButtonStyle}"/>
                    </WrapPanel>
                    <TextBlock Text="{lex:Loc Profiles}" VerticalAlignment="Center" Style="{DynamicResource BridgeSectionTitleStyle}" Margin="0,0,10,0"/>
                </DockPanel>
                <ScrollViewer Style="{DynamicResource BridgeDropDownScrollViewerStyle}" CanContentScroll="False" Padding="0,0,6,0">
                    <ItemsControl x:Name="profilesListBox" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                                          Margin="0,0,0,4" MinHeight="30" Style="{DynamicResource BridgeLabeledCheckBoxStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="cancelBtn" Content="{lex:Loc Cancel}" MinWidth="96" Margin="0,0,8,0" IsCancel="True"
                    Click="CancelBtn_Click" Style="{DynamicResource BridgeSecondaryButtonStyle}"/>
            <Button x:Name="okBtn" Content="{lex:Loc Save}" MinWidth="96" IsDefault="True"
                    Click="OkBtn_Click" Style="{DynamicResource BridgePrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
