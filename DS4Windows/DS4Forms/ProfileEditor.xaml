                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc VirtualControllerSettings}" Style="{DynamicResource BridgeSectionTitleStyle}"/>
                                        <TextBlock Text="Choose the controller games receive from this profile." Style="{DynamicResource BridgeSectionDescriptionStyle}"/>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                                <Label Content="{lex:Loc EmulatedController}" ToolTip="{lex:Loc OutContNotice}" VerticalAlignment="Center" Padding="0" Margin="0,4,10,10"/>
                                                <ComboBox x:Name="outConTypeCombo" Width="220" SelectedIndex="{Binding TempControllerIndex, FallbackValue=0}" IsEnabled="{Binding DInputOnly, Converter={StaticResource InverseBoolConverter}}" MinWidth="140" ToolTip="{lex:Loc OutContNotice}" MinHeight="34" VerticalAlignment="Center">
                                                    <ComboBoxItem Content="DualShock 4"/>
                                                    <ComboBoxItem Content="Xbox 360"/>
                                                    <ComboBoxItem Content="DualSense"/>
                                                    <ComboBoxItem Content="DualSense Edge"/>
                                                    <ComboBoxItem Content="Switch 2 Pro"/>
                                                    <ComboBoxItem Content="Xbox One / Series"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <TextBlock x:Name="outputControllerHintText" TextWrapping="Wrap" MaxWidth="430" Margin="6,0,0,8" Opacity="0.78" HorizontalAlignment="Left"/>
                                            <StackPanel x:Name="switch2ViiperLegendPanel" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed" VerticalAlignment="Center">
                                                <Grid Width="92" Height="72" Margin="0,0,10,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="24"/>
                                                        <RowDefinition Height="24"/>
                                                        <RowDefinition Height="24"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{DynamicResource ForegroundColor}" BorderThickness="1" CornerRadius="12" Width="24" Height="24">
                                                        <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource ForegroundColor}" BorderThickness="1" CornerRadius="12" Width="24" Height="24">
                                                        <TextBlock Text="Y" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource ForegroundColor}" BorderThickness="1" CornerRadius="12" Width="24" Height="24">
                                                        <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="{DynamicResource ForegroundColor}" BorderThickness="1" CornerRadius="12" Width="24" Height="24">
                                                        <TextBlock Text="B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Nintendo face layout" FontWeight="Bold"/>
                                                    <TextBlock Text="Plus, Minus, Home, Capture, L/R, ZL/ZR" Opacity="0.78"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox ContentTemplate="{DynamicResource ProfileAdvancedCheckContentTemplate}" Content="{lex:Loc DisableVirtualController}" IsChecked="{Binding DInputOnly}" ToolTip="{lex:Loc DisableVirtualControllerTip}" Style="{DynamicResource BridgeLabeledCheckBoxStyle}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,12" VerticalAlignment="Center">
                                                <Label Content="{lex:Loc ProfileEditor.VirtualDS4TrigOutput}" ContentStringFormat="{}{0}:" Margin="0,4,10,10" VerticalAlignment="Center" Padding="0"/>
                                                <ComboBox MinWidth="220" ItemsSource="{Binding Path=OutputDS4TriggerModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="ChoiceValue" SelectedValue="{Binding OutputDS4TriggerMode}" MinHeight="34" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!--<CheckBox ContentTemplate="{DynamicResource ProfileAdvancedCheckContentTemplate}" Content="{lex:Loc ProfileEditor.VirtualTrigButtonOutput}" IsChecked="{Binding VirtualTriggerButtons}"
                                              Margin="0,8,0,0" />-->
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Game Bar" Style="{DynamicResource BridgeSectionTitleStyle}"/>
                                        <TextBlock Text="Optional compatibility while Xbox Game Bar is open." Style="{DynamicResource BridgeSectionDescriptionStyle}"/>
                                        <StackPanel>
                                            <CheckBox ContentTemplate="{DynamicResource ProfileAdvancedCheckContentTemplate}" Content="Enable Game Bar controller compatibility" IsChecked="{Binding GameBarControllerCompatibility}" Margin="{StaticResource spaceMargin}" ToolTip="While Xbox Game Bar is visible, temporarily route this profile's mapped input through an Xbox-compatible controller. The selected profile and native DualSense output stay configured." Style="{DynamicResource BridgeLabeledCheckBoxStyle}"/>
                                            <TextBlock Margin="8,0,8,6" TextWrapping="Wrap" Text="Keeps this profile and its native output active. Only mapped input is temporarily sent through an Xbox-compatible companion while Game Bar is open; audio, haptics, lighting, and microphone routing stay untouched."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsChecked, ElementName=profileAdvancedFeedbackNav, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Control feedback sent from games to your physical controller." Style="{DynamicResource BridgeSectionDescriptionStyle}"/>
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Game feedback" Style="{DynamicResource BridgeSectionTitleStyle}"/>
