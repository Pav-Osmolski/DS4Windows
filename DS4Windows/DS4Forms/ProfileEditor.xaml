                            </Border>
                            <Border Style="{StaticResource Switch2SettingsCardStyle}">
                                <Expander x:Name="switch2StickCard" IsExpanded="false" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Point, scroll or tap with a stick">
