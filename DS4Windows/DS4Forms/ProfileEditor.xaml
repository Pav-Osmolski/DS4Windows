                                            <CheckBox ContentTemplate="{DynamicResource ProfileAdvancedCheckContentTemplate}" Content="{lex:Loc SendGameFeedbackToPhysicalController}" IsChecked="{Binding EnableOutputDataToDS4}" FontWeight="SemiBold" ToolTip="{lex:Loc SendGameFeedbackToPhysicalControllerTip}" Style="{DynamicResource BridgeLabeledCheckBoxStyle}"/>
                                            <TextBlock Text="{lex:Loc SendGameFeedbackToPhysicalControllerTip}" Margin="20,4,8,0" MaxWidth="560" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc Rumble}" Style="{DynamicResource BridgeSectionTitleStyle}"/>
