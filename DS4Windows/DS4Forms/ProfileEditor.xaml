                                                <Button x:Name="gyroCalBtn2" Content="Gyro Calibration" MinWidth="100" Click="GyroCalibration_Click" MinHeight="34" Padding="12,7" Style="{DynamicResource BridgeSecondaryButtonStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="{lex:Loc Passthru}" Visibility="Collapsed">
                                <StackPanel x:Name="passthruPanel">
                                    <Border Style="{DynamicResource BridgeCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Calibration" Style="{DynamicResource BridgeSectionTitleStyle}"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                                <Button x:Name="gyroCalBtn3" Content="Gyro Calibration" MinWidth="100" Click="GyroCalibration_Click" MinHeight="34" Padding="12,7" Style="{DynamicResource BridgeSecondaryButtonStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                        <Border Style="{DynamicResource BridgeCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Experimental compatibility" Style="{DynamicResource BridgeSectionTitleStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                    <CheckBox Content="{lex:Loc UseDs3PitchRollSim}" IsChecked="{Binding UseDs3PitchRollSim}" ToolTip="{lex:Loc UseDs3PitchRollSimTooltip}" Style="{DynamicResource BridgeLabeledCheckBoxStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Audio Haptics" Tag="Turn system or app audio into advanced controller haptics">
                <local:AudioHapticsControl x:Name="profileAudioHapticsControl"
                                           SettingsChanged="ProfileAudioHapticsControl_SettingsChanged" />
            </TabItem>

            <TabItem Header="Trigger Lab" Tag="Build persistent adaptive-trigger effects for this profile">
                <local:TriggerLabControl x:Name="profileTriggerLabControl"
                                         SettingsChanged="ProfileTriggerLabControl_SettingsChanged" />
            </TabItem>

            <TabItem x:Name="switch2ControlsTab" Header="Nintendo Options" Tag="HD rumble, motion, Joy-Con mouse modes, calibration, and controller behavior">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Margin="4" Padding="16" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowSwitch2Controls}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Nintendo Options" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.78" Text="These settings are saved with the profile and apply to controllers that support them."/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="switch2SettingsPanel" Margin="8,8,8,0" HorizontalAlignment="Stretch" Visibility="{Binding ShowSwitch2Controls, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel.Resources>
                                <Style x:Key="Switch2SettingsCardStyle" TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="Padding" Value="18"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                </Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxStyle}">
                                    <Setter Property="Margin" Value="0,6,0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="ToolTip" BasedOn="{StaticResource ToolTipStyle}">
                                    <Setter Property="MaxWidth" Value="320"/>
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BridgeSecondaryButtonStyle}">
                                    <Setter Property="MinHeight" Value="34"/>
                                </Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                                </Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource BridgeSettingsComboBoxStyle}"/>
                                <Style x:Key="NintendoInsetStyle" TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                    <Setter Property="Padding" Value="12"/>
                                    <Setter Property="Margin" Value="0,12,0,0"/>
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="Make the controller work your way" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Set up mouse control, motion aiming, feedback and alternate button actions." TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource MutedForegroundColor}"/>
                            <TextBlock Text="Saved with this profile. Features apply only to compatible controllers; desk mouse and motion aiming are separate." TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource MutedForegroundColor}"/>
                            <Border Style="{StaticResource Switch2SettingsCardStyle}" Visibility="{Binding ShowSwitch2JoyConControls, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Expander x:Name="switch2JoyConCard" IsExpanded="true" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Mouse on a desk">
                                    <Expander.Header>
                                        <DockPanel LastChildFill="True" Margin="4,0,0,0">
                                            <Image Source="{x:Static local:Switch2FeatureArtwork.DeskMouse}" Width="64" Height="44" Stretch="Uniform" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Mouse on a desk" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Slide a Joy-Con to point or aim. Use its stick to scroll." Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="24,10,0,0">
                                        <CheckBox x:Name="Switch2JoyConIrMouseEnabledCheckBox" IsChecked="{Binding Switch2JoyConIrMouseEnabled}" Margin="0,4,0,0" Content="Slide a Joy-Con to move the mouse" ToolTip="Move a Joy-Con across a surface to control the mouse pointer."/>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" Text="Place the sensor edge against a desk or mouse mat, then slide the Joy-Con. Lifting it lets you reposition without moving the pointer." Foreground="{DynamicResource MutedForegroundColor}"/>
                                            <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" Text="Slide to aim or point at menus. Use the stick to scroll while the sensor touches the surface." Foreground="{DynamicResource MutedForegroundColor}"/>
                                            <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" Text="Assign mouse clicks in Button Mapping. For different actions only while on the desk, use the matching IR Sensor as the Shift Modifier." Foreground="{DynamicResource MutedForegroundColor}"/>
                                            <WrapPanel Margin="0,5,0,4">
                                                <TextBlock Text="Which Joy-Con:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                <ComboBox MinHeight="34" MinWidth="120" IsEnabled="{Binding IsChecked, ElementName=Switch2JoyConIrMouseEnabledCheckBox}" SelectedIndex="{Binding Switch2JoyConIrMouseSourceIndex}" Margin="0,0,8,8">
                                                    <ComboBoxItem Content="Automatic"/>
                                                    <ComboBoxItem Content="Left"/>
                                                    <ComboBoxItem Content="Right"/>
                                                    <ComboBoxItem Content="Both"/>
                                                </ComboBox>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,0,0,4">
                                                <TextBlock Text="Stick scroll:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                <ComboBox MinHeight="34" MinWidth="145" IsEnabled="{Binding IsChecked, ElementName=Switch2JoyConIrMouseEnabledCheckBox}" SelectedIndex="{Binding Switch2JoyConIrMouseScrollModeIndex}" ToolTip="Choose whether the stick scrolls vertically only or in all four directions." Margin="0,0,8,8">
                                                    <ComboBoxItem Content="Up / Down"/>
                                                    <ComboBoxItem Content="Four-way"/>
                                                </ComboBox>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,0,0,4">
                                                <TextBlock Text="Left sensitivity:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                <xctk:DoubleUpDown MinHeight="34" MinWidth="72" FormatString="F1" IsEnabled="{Binding IsChecked, ElementName=Switch2JoyConIrMouseEnabledCheckBox}" Minimum="1.0" Maximum="10.0" Increment="0.2" Value="{Binding Switch2JoyConLeftIrMouseSensitivity}" Margin="0,0,8,8"/>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,0,0,4">
                                                <TextBlock Text="Right sensitivity:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                <xctk:DoubleUpDown MinHeight="34" MinWidth="72" FormatString="F1" IsEnabled="{Binding IsChecked, ElementName=Switch2JoyConIrMouseEnabledCheckBox}" Minimum="1.0" Maximum="10.0" Increment="0.2" Value="{Binding Switch2JoyConRightIrMouseSensitivity}" Margin="0,0,8,8"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Expander Header="Surface detection" Margin="0,14,0,0">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="Try Relaxed if your surface is not detected. These settings also affect surface-triggered button actions and aiming." TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <WrapPanel Margin="0,0,0,4">
                                                    <TextBlock Text="Left surface detection:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                    <ComboBox MinHeight="34" MinWidth="120" SelectedIndex="{Binding Switch2JoyConLeftIrMouseActivationThresholdIndex}" Margin="0,0,8,8">
                                                        <ComboBoxItem Content="Strict"/>
                                                        <ComboBoxItem Content="Balanced"/>
                                                        <ComboBoxItem Content="Relaxed"/>
                                                    </ComboBox>
                                                </WrapPanel>
                                                <WrapPanel Margin="0,0,0,4">
                                                    <TextBlock Text="Right surface detection:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                    <ComboBox MinHeight="34" MinWidth="120" SelectedIndex="{Binding Switch2JoyConRightIrMouseActivationThresholdIndex}" Margin="0,0,8,8">
                                                        <ComboBoxItem Content="Strict"/>
                                                        <ComboBoxItem Content="Balanced"/>
                                                        <ComboBoxItem Content="Relaxed"/>
                                                    </ComboBox>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Expander>
                            </Border>
                            <Border Style="{StaticResource Switch2SettingsCardStyle}">
                                <Expander x:Name="switch2MotionCard" IsExpanded="true" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Aim by tilting">
                                    <Expander.Header>
                                        <DockPanel LastChildFill="True" Margin="4,0,0,0">
                                            <Image Source="{x:Static local:Switch2FeatureArtwork.Aim}" Width="64" Height="44" Stretch="Uniform" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Aim by tilting" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Fine aim with your hands, with or without a mouse pointer." Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="24,10,0,0">
                                        <TextBlock Text="Choose what tilting does" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox SelectedIndex="{Binding Switch2AimSetup.OutputIndex}" MinHeight="34" MaxWidth="340" HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="Motion aiming output">
                                            <ComboBoxItem Content="Mapped tilt buttons (no mouse)"/>
                                            <ComboBoxItem Content="Mouse pointer"/>
                                            <ComboBoxItem Content="Virtual aiming stick"/>
                                            <ComboBoxItem Content="Quick-tilt actions"/>
                                            <ComboBoxItem Content="Game's own motion controls"/>
                                        </ComboBox>
                                        <TextBlock Text="{Binding Switch2AimSetup.Description}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                        <StackPanel Visibility="{Binding Switch2AimSetup.CanChooseActivation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <WrapPanel>
                                                <TextBlock Text="When to aim:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                <ComboBox SelectedIndex="{Binding Switch2AimSetup.ActivationIndex}" MinHeight="34" MinWidth="200" AutomationProperties.Name="Motion aiming activation">
                                                    <ComboBoxItem Content="Always on"/>
                                                    <ComboBoxItem Content="Hold ZL / L2"/>
                                                    <ComboBoxItem Content="Hold ZR / R2"/>
                                                    <ComboBoxItem Content="Custom — see Gyro settings" IsEnabled="False"/>
                                                </ComboBox>
                                            </WrapPanel>
                                            <TextBlock Text="Trigger choices follow your button layout. Custom combinations and toggle-to-aim are available in Gyro settings." TextWrapping="Wrap" Margin="0,6,0,10" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        </StackPanel>
                                        <WrapPanel Visibility="{Binding Switch2AimSetup.IsMouse, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Mouse aiming speed:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                            <xctk:IntegerUpDown Value="{Binding GyroSensitivity}" Minimum="0" Maximum="500" Increment="5" Width="80" MinHeight="34"/>
                                            <TextBlock Text="%" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </WrapPanel>
                                        <Button Content="Open full Gyro settings…" Click="Switch2OpenGyroSettings_Click" HorizontalAlignment="Left" Margin="0,12,0,8" Padding="12,6" ToolTip="Choose aim buttons, stick output, sensitivity and smoothing."/>
                                        <Expander Header="Fine-tune aiming" Margin="0,10,0,0">
                                            <StackPanel Margin="0,8,0,0">
                                                <CheckBox IsChecked="{Binding Switch2MagnetometerYawAssistEnabled}" Margin="0,7,0,0" Content="Reduce sideways gyro drift" ToolTip="Help reduce sideways gyro drift. Turn this off if nearby electronics affect aiming."/>
                                                <WrapPanel Margin="0,5,0,4" ToolTip="Ignore tiny gyro movements to steady aim. Set to 0 for maximum sensitivity.">
                                                    <TextBlock Text="Ignore small movements:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                    <xctk:DoubleUpDown MinHeight="34" Value="{Binding Switch2VirtualGyroSoftDeadzone}" Minimum="0" Maximum="100" Increment="0.5" FormatString="F1" Width="75" Margin="0,0,8,8"/>
                                                </WrapPanel>
                                                <WrapPanel Margin="0,0,0,4" ToolTip="Use the stick alongside gyro aiming to turn further. Set to 0 to turn this off.">
                                                    <TextBlock Text="Stick-assisted aiming:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                    <xctk:DoubleUpDown MinHeight="34" Value="{Binding Switch2GyroMouseStickAssistSensitivity}" Minimum="0" Maximum="10" Increment="0.2" FormatString="F1" Width="75" Margin="0,0,8,8"/>
                                                </WrapPanel>
                                                <CheckBox IsChecked="{Binding Switch2HighRateMousePresentation}" Margin="0,7,0,0" Content="Smoother mouse movement" ToolTip="Make mouse movement smoother between controller updates. This does not speed up the controller itself."/>
                                                <WrapPanel Margin="0,5,0,4" ToolTip="Adjust sideways motion sensitivity in compatible emulators. 1 is the normal level.">
                                                    <TextBlock Text="Emulator turn sensitivity:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                    <xctk:IntegerUpDown MinHeight="34" Value="{Binding Switch2CemuhookYawSensitivity}" Minimum="1" Maximum="5" Increment="1" Width="60" Margin="0,0,8,8"/>
                                                </WrapPanel>
                                                <CheckBox IsChecked="{Binding Switch2HorizonStabilizationEnabled}" Margin="0,7,0,0" Content="Keep motion aiming level" ToolTip="Keep motion aiming level when you tilt the controller."/>
                                                <Expander Header="Pause aiming with a button" Margin="0,9,0,0" ToolTip="Pause motion aiming with a button so you can reposition the controller.">
                                                    <StackPanel Margin="0,8,0,0">
                                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="Hold to pause aiming, or press to toggle the pause. The pause clears when you stop using gyro." Foreground="{DynamicResource MutedForegroundColor}"/>
                                                        <WrapPanel Margin="0,0,0,7">
                                                            <TextBlock Text="Aiming settings to edit:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <ComboBox MinHeight="34" Width="160" ItemsSource="{Binding Switch2GyroLockEditor.ModeChoices}" SelectedIndex="{Binding Switch2GyroLockEditor.SelectedModeIndex}"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="Hold-to-lock buttons:" FontWeight="SemiBold"/>
                                                        <ItemsControl ItemsSource="{Binding Switch2GyroLockEditor.HoldButtonChoices}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8,6" Width="156" Margin="0,0,8,8">
                                                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0" MinHeight="22"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="Press-to-toggle lock buttons:" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                                        <ItemsControl ItemsSource="{Binding Switch2GyroLockEditor.ToggleButtonChoices}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8,6" Width="156" Margin="0,0,8,8">
                                                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0" MinHeight="22"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                                <Expander Header="Steady aim around button presses" Margin="0,9,0,0" ToolTip="Reduce aim movement caused by pressing or releasing buttons.">
                                                    <StackPanel Margin="0,8,0,0">
                                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="Fine-tune a mode you have already enabled above. These choices do not switch your aiming output." Foreground="{DynamicResource MutedForegroundColor}"/>
                                                        <WrapPanel Margin="0,0,0,7">
                                                            <TextBlock Text="Aiming settings to edit:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <ComboBox MinHeight="34" Width="160" ItemsSource="{Binding Switch2GyroTriggerEditor.ModeChoices}" SelectedIndex="{Binding Switch2GyroTriggerEditor.SelectedModeIndex}"/>
                                                            <TextBlock Text="activation source:" VerticalAlignment="Center" Margin="12,0,5,0"/>
                                                            <ComboBox MinHeight="34" Width="220" ItemsSource="{Binding Switch2GyroTriggerEditor.TriggerChoices}" SelectedIndex="{Binding Switch2GyroTriggerEditor.SelectedTriggerIndex}"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="Buttons that steady aim:" FontWeight="SemiBold"/>
                                                        <ItemsControl ItemsSource="{Binding Switch2GyroTriggerEditor.DeadzoneButtonChoices}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8,6" Width="156" Margin="0,0,8,8">
                                                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0" MinHeight="22"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <WrapPanel Margin="0,5,0,0">
                                                            <TextBlock Text="Deadzone:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <xctk:DoubleUpDown MinHeight="34" Value="{Binding Switch2GyroTriggerEditor.DeadzoneAmount}" Minimum="0" Maximum="100" Increment="0.5" FormatString="F1" Width="68"/>
                                                            <TextBlock Text="press pause:" VerticalAlignment="Center" Margin="12,0,5,0"/>
                                                            <xctk:IntegerUpDown MinHeight="34" Value="{Binding Switch2GyroTriggerEditor.PauseAfterPressedMilliseconds}" Minimum="0" Maximum="60000" Width="72"/>
                                                            <TextBlock Text="ms" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                        </WrapPanel>
                                                        <WrapPanel Margin="0,4,0,0">
                                                            <TextBlock Text="Release pause:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <xctk:IntegerUpDown MinHeight="34" Value="{Binding Switch2GyroTriggerEditor.PauseAfterReleasedMilliseconds}" Minimum="0" Maximum="60000" Width="72"/>
                                                            <TextBlock Text="ms" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                            <TextBlock Text="deadzone after release:" VerticalAlignment="Center" Margin="12,0,5,0"/>
                                                            <xctk:IntegerUpDown MinHeight="34" Value="{Binding Switch2GyroTriggerEditor.DeadzoneEffectAfterReleasedMilliseconds}" Minimum="0" Maximum="60000" Width="72"/>
                                                            <TextBlock Text="ms" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="Buttons that slow aim:" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                                        <ItemsControl ItemsSource="{Binding Switch2GyroTriggerEditor.DampeningButtonChoices}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8,6" Width="156" Margin="0,0,8,8">
                                                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0" MinHeight="22"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <WrapPanel Margin="0,5,0,0">
                                                            <TextBlock Text="Dampening:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <xctk:DoubleUpDown MinHeight="34" Value="{Binding Switch2GyroTriggerEditor.DampeningAmountPercent}" Minimum="0" Maximum="100" Increment="1" FormatString="F0" Width="68"/>
                                                            <TextBlock Text="%" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                            <TextBlock Text="after release:" VerticalAlignment="Center" Margin="12,0,5,0"/>
                                                            <xctk:IntegerUpDown MinHeight="34" Value="{Binding Switch2GyroTriggerEditor.DampeningEffectAfterReleasedMilliseconds}" Minimum="0" Maximum="60000" Width="72"/>
                                                            <TextBlock Text="ms" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Expander>
                                                <Expander Header="Steady aiming when touching a desk" Margin="0,9,0,0" Visibility="{Binding ShowSwitch2JoyConControls, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Margin="0,8,0,0">
                                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="Choose the left or right IR Sensor in the Gyro trigger menu to aim while touching a surface." Foreground="{DynamicResource MutedForegroundColor}"/>
                                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="Pause aiming around button presses, ignore small movements, or reduce sensitivity while a button is held." Foreground="{DynamicResource MutedForegroundColor}"/>
                                                        <GroupBox Header="Left optical sensor" Padding="7,5" Margin="0,2,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="Deadzone / click-stabilization buttons:" FontWeight="SemiBold"/>
                                                                <ItemsControl ItemsSource="{Binding Switch2JoyConLeftIrGyroDeadzoneButtonChoices}" Margin="0,8,0,0">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8,6" Width="156" Margin="0,0,8,8">
                                                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0" MinHeight="22"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
