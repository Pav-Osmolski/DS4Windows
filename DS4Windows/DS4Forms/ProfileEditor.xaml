                            <TextBlock x:Name="sizeMsg" Text="{lex:Loc Strings:UI_8B01088E42740A48}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

