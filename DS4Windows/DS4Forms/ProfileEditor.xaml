                                                    </DockPanel>
                                                    <DockPanel Margin="0,0,16,12">
                                                        <TextBlock Text="Auto-stop" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <Label Content="{lex:Loc RumbleMaxSecs}" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="0" Margin="0,4,10,10"/>
                                                        <xctk:IntegerUpDown x:Name="RumbleAutostopTimeIUD" d:IsHidden="True" Value="{Binding RumbleAutostopTime}" Minimum="0" Maximum="3600" Increment="1" ToolTip="{lex:Loc RumbleMaxSecsTip}" MinWidth="50" DockPanel.Dock="Left" MinHeight="34" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </WrapPanel>
                                                <Button x:Name="heavyRumbleTestBtn" Content="{lex:Loc TestHeavy}" Margin="0,0,8,12" Click="RumbleTestBtn_Click" Style="{DynamicResource BridgeSecondaryButtonStyle}"/>
                                                <Button x:Name="lightRumbleTestBtn" Content="{lex:Loc TestLight}" Margin="0,0,8,12" Click="RumbleTestBtn_Click" Style="{DynamicResource BridgeSecondaryButtonStyle}"/>
                                            </WrapPanel>
                                            <CheckBox ContentTemplate="{DynamicResource ProfileAdvancedCheckContentTemplate}" Content="{lex:Loc InverseMotors}" IsChecked="{Binding InverseRumbleMotors}" Style="{DynamicResource BridgeLabeledCheckBoxStyle}"/>
                                            <CheckBox ContentTemplate="{DynamicResource ProfileAdvancedCheckContentTemplate}" x:Name="XboxImpulseTriggersCheckBox" IsChecked="{Binding MapXboxImpulseTriggers}" Content="Translate Xbox impulse-trigger vibration" Margin="0,5,0,0" ToolTip="Feel Xbox trigger vibrations through your controller's triggers or rumble motors. Works independently of Trigger Lab." Style="{DynamicResource BridgeLabeledCheckBoxStyle}"/>
                                            <StackPanel Margin="20,4,0,0" IsEnabled="{Binding MapXboxImpulseTriggers}">
