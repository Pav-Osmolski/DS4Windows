                                    <StackPanel>
                                        <TextBlock Text="Idle disconnect" Style="{DynamicResource BridgeSectionTitleStyle}"/>
                                        <TextBlock Text="Disconnect an inactive Bluetooth controller to save battery." Style="{DynamicResource BridgeSectionDescriptionStyle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                            <CheckBox ContentTemplate="{DynamicResource ProfileAdvancedCheckContentTemplate}" Content="{lex:Loc IdleDisconnect}" VerticalAlignment="Center" IsChecked="{Binding IdleDisconnectExists}" Style="{DynamicResource BridgeLabeledCheckBoxStyle}"/>
                                            <xctk:IntegerUpDown x:Name="idleDisconnectUD" d:IsHidden="True" Value="{Binding IdleDisconnect,FallbackValue=5}" IsEnabled="{Binding IdleDisconnectExists}" MinWidth="50" Minimum="0" Maximum="60" Margin="10,0,0,0" MinHeight="34" VerticalAlignment="Center"/>
                                            <Label Content="mins" VerticalAlignment="Center" Padding="0" Margin="0,4,10,10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="DualShock 4 Bluetooth" Style="{DynamicResource BridgeSectionTitleStyle}"/>
                                        <TextBlock Text="This polling setting applies to DualShock 4 Bluetooth reports." Style="{DynamicResource BridgeSectionDescriptionStyle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                            <Label Content="{lex:Loc DS4BTPollRate}" ContentStringFormat="{}{0}:" ToolTip="{lex:Loc Resources:BtPollRate}" VerticalAlignment="Center" Padding="0" Margin="0,4,10,10"/>
                                            <ComboBox x:Name="btPollRateCombo" SelectedIndex="{Binding TempBTPollRateIndex,FallbackValue=4}" MinWidth="140" ToolTip="{lex:Loc Resources:BtPollRate}" Margin="8,0,0,0" MinHeight="34" VerticalAlignment="Center">
                                                <ComboBoxItem Content="Max (1 ms)"/>
                                                <ComboBoxItem Content="1000 Hz (1 ms)"/>
                                                <ComboBoxItem Content="500 Hz (2 ms)"/>
                                                <ComboBoxItem Content="333 Hz (3 ms)"/>
                                                <ComboBoxItem Content="250 Hz (4 ms)"/>
                                                <ComboBoxItem Content="200 Hz (5 ms)"/>
                                                <ComboBoxItem Content="166 Hz (6 ms)"/>
                                                <ComboBoxItem Content="142 Hz (7 ms)"/>
                                                <ComboBoxItem Content="125 Hz (8 ms)"/>
                                                <ComboBoxItem Content="111 Hz (9 ms)"/>
                                                <ComboBoxItem Content="100 Hz (10 ms)"/>
                                                <ComboBoxItem Content="90 Hz (11 ms)"/>
                                                <ComboBoxItem Content="83 Hz (12 ms)"/>
                                                <ComboBoxItem Content="76 Hz (13 ms)"/>
                                                <ComboBoxItem Content="71 Hz (14 ms)"/>
                                                <ComboBoxItem Content="66 Hz (15 ms)"/>
                                                <ComboBoxItem Content="62 Hz (16 ms)"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Launch a program" Style="{DynamicResource BridgeSectionTitleStyle}"/>
                                        <TextBlock Text="Select a program to launch when this profile is activated." Style="{DynamicResource BridgeSectionDescriptionStyle}"/>
                                        <WrapPanel>
                                            <CheckBox ContentTemplate="{DynamicResource ProfileAdvancedCheckContentTemplate}" x:Name="launchProgCk" Content="{lex:Loc LaunchProgramWithProfile}" IsChecked="{Binding LaunchProgramExists}" IsEnabled="{Binding LaunchProgramExists}" VerticalAlignment="Center" Margin="0,0,12,8" Style="{DynamicResource BridgeLabeledCheckBoxStyle}"/>
                                            <Button x:Name="launchProgBrowseBtn" Click="LaunchProgBrowseBtn_Click" Margin="0,0,12,8" VerticalAlignment="Center" Style="{DynamicResource BridgeSecondaryButtonStyle}">
                                                <Button.Content>
                                                    <PriorityBinding>
                                                        <Binding Path="LaunchProgramName"/>
                                                        <lex:BLoc Key="Browse"/>
                                                    </PriorityBinding>
                                                </Button.Content>
                                            </Button>
                                            <Image x:Name="launchProgIconImage" Source="{Binding LaunchProgramIcon}" Width="20" Height="20" Margin="0,0,0,8" VerticalAlignment="Center">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
