                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                                            <Label Content="G" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
