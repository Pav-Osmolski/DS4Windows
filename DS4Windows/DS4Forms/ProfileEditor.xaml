                                            <WrapPanel>
                                                <WrapPanel HorizontalAlignment="Left">
                                                    <DockPanel Margin="0,0,16,12">
                                                        <TextBlock Text="Strength" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"/>
