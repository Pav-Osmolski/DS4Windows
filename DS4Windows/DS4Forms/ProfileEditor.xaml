                    <Button x:Name="saveBtn" Content="{lex:Loc SaveProfile}" Margin="8,3,0,3" Click="SaveBtn_Click" Style="{StaticResource BridgePrimaryButtonStyle}" />
                    <Button x:Name="keepSizeBtn" Style="{DynamicResource BridgeSecondaryButtonStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="8,3,0,3" Click="KeepSizeBtn_Click" ToolTip="{lex:Loc Strings:UI_6AEC8557B33FBAD5}">
                        <StackPanel Orientation="Horizontal" Margin="0">
