                                                    <ComboBoxItem Content="Tap"/>
                                                </ComboBox>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,0,0,4">
                                                <TextBlock Text="Right stick:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                <ComboBox MinHeight="34" MinWidth="100" SelectedIndex="{Binding Switch2RightStickScrollActivationModeIndex}" Margin="0,0,8,8">
                                                    <ComboBoxItem Content="Hold"/>
                                                    <ComboBoxItem Content="Tap"/>
                                                </ComboBox>
                                            </WrapPanel>
                                            <TextBlock Margin="0,7,0,3" FontWeight="SemiBold" Text="Stick button actions"/>
                                            <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" Text="Hold keeps an action pressed. Tap triggers it once each time you move the stick into that direction." Foreground="{DynamicResource MutedForegroundColor}"/>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Left stick" FontWeight="SemiBold" Margin="0,0,14,3"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Right stick" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Up" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Down" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Left" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Right" VerticalAlignment="Center"/>
                                                <ComboBox MinHeight="34" Grid.Row="1" Grid.Column="1" MinWidth="86" Margin="0,0,14,3" SelectedIndex="{Binding Switch2LeftStickUpActivationModeIndex}">
                                                    <ComboBoxItem Content="Hold"/>
                                                    <ComboBoxItem Content="Tap"/>
                                                </ComboBox>
                                                <ComboBox MinHeight="34" Grid.Row="2" Grid.Column="1" MinWidth="86" Margin="0,0,14,3" SelectedIndex="{Binding Switch2LeftStickDownActivationModeIndex}">
                                                    <ComboBoxItem Content="Hold"/>
                                                    <ComboBoxItem Content="Tap"/>
                                                </ComboBox>
                                                <ComboBox MinHeight="34" Grid.Row="3" Grid.Column="1" MinWidth="86" Margin="0,0,14,3" SelectedIndex="{Binding Switch2LeftStickLeftActivationModeIndex}">
                                                    <ComboBoxItem Content="Hold"/>
                                                    <ComboBoxItem Content="Tap"/>
                                                </ComboBox>
                                                <ComboBox MinHeight="34" Grid.Row="4" Grid.Column="1" MinWidth="86" Margin="0,0,14,0" SelectedIndex="{Binding Switch2LeftStickRightActivationModeIndex}">
                                                    <ComboBoxItem Content="Hold"/>
                                                    <ComboBoxItem Content="Tap"/>
                                                </ComboBox>
                                                <ComboBox MinHeight="34" Grid.Row="1" Grid.Column="2" MinWidth="86" Margin="0,0,0,3" SelectedIndex="{Binding Switch2RightStickUpActivationModeIndex}">
                                                    <ComboBoxItem Content="Hold"/>
                                                    <ComboBoxItem Content="Tap"/>
                                                </ComboBox>
                                                <ComboBox MinHeight="34" Grid.Row="2" Grid.Column="2" MinWidth="86" Margin="0,0,0,3" SelectedIndex="{Binding Switch2RightStickDownActivationModeIndex}">
                                                    <ComboBoxItem Content="Hold"/>
                                                    <ComboBoxItem Content="Tap"/>
                                                </ComboBox>
                                                <ComboBox MinHeight="34" Grid.Row="3" Grid.Column="2" MinWidth="86" Margin="0,0,0,3" SelectedIndex="{Binding Switch2RightStickLeftActivationModeIndex}">
                                                    <ComboBoxItem Content="Hold"/>
                                                    <ComboBoxItem Content="Tap"/>
                                                </ComboBox>
                                                <ComboBox MinHeight="34" Grid.Row="4" Grid.Column="2" MinWidth="86" SelectedIndex="{Binding Switch2RightStickRightActivationModeIndex}">
                                                    <ComboBoxItem Content="Hold"/>
                                                    <ComboBoxItem Content="Tap"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Margin="0,7,0,3" FontWeight="SemiBold" Text="Stick mouse speed"/>
                                            <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" Text="Adjust speed for sticks mapped to mouse movement. 5 is the normal speed; 0 stops movement." Foreground="{DynamicResource MutedForegroundColor}"/>
                                            <WrapPanel Margin="0,5,0,4">
                                                <TextBlock Text="Left stick:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                <xctk:DoubleUpDown MinHeight="34" MinWidth="72" FormatString="F1" Minimum="0.0" Maximum="10.0" Increment="0.2" Value="{Binding Switch2LeftStickMouseSensitivity}" Margin="0,0,8,8"/>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,0,0,4">
                                                <TextBlock Text="Right stick:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                                <xctk:DoubleUpDown MinHeight="34" MinWidth="72" FormatString="F1" Minimum="0.0" Maximum="10.0" Increment="0.2" Value="{Binding Switch2RightStickMouseSensitivity}" Margin="0,0,8,8"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </Border>
                            <Border Style="{StaticResource Switch2SettingsCardStyle}">
                                <Expander x:Name="switch2ConnectionCard" IsExpanded="false" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Layout &amp; battery">
                                    <Expander.Header>
                                        <DockPanel LastChildFill="True" Margin="4,0,0,0">
                                            <Image Source="{x:Static local:Switch2FeatureArtwork.Layout}" Width="64" Height="44" Stretch="Uniform" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Layout &amp; battery" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Match your button labels, hold a single Joy-Con sideways, or save battery." Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="24,10,0,0">
                                        <WrapPanel Margin="0,0,0,4" ToolTip="Xbox follows button positions. Nintendo follows the printed A, B, X and Y labels.">
                                            <TextBlock Text="Face-button layout:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                            <ComboBox MinHeight="34" MinWidth="120" SelectedIndex="{Binding Switch2FaceButtonLayoutIndex}" Margin="0,0,8,8">
                                                <ComboBoxItem Content="Xbox"/>
                                                <ComboBoxItem Content="Nintendo"/>
                                            </ComboBox>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,0,0,4" Visibility="{Binding ShowSwitch2StandaloneJoyConControls, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Joy-Con holding style:" VerticalAlignment="Center" Width="160" Margin="0,0,12,8"/>
                                            <ComboBox MinHeight="34" MinWidth="120" SelectedIndex="{Binding Switch2JoyConStandaloneHoldModeIndex}" ToolTip="Choose the starting orientation. A choice made on the Controllers tab takes priority for that Joy-Con." Margin="0,0,8,8">
                                                <ComboBoxItem Content="Upright"/>
                                                <ComboBoxItem Content="Sideways"/>
                                            </ComboBox>
                                        </WrapPanel>
                                        <GroupBox Header="Automatic Bluetooth disconnect" Padding="7,5" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5" Text="Disconnect after inactivity to save battery, or after a set time even while playing." Foreground="{DynamicResource MutedForegroundColor}"/>
                                                <WrapPanel>
                                                    <StackPanel Margin="0,0,16,12">
                                                        <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                                        <ComboBox MinHeight="34" Width="150" SelectedIndex="{Binding Switch2AutoDisconnectModeIndex}">
                                                            <ComboBoxItem Content="Off"/>
                                                            <ComboBoxItem Content="When idle"/>
                                                            <ComboBoxItem Content="After a set time"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,12">
                                                        <TextBlock Text="Disconnect after:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                                        <WrapPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                                <xctk:IntegerUpDown MinHeight="34" Value="{Binding Switch2AutoDisconnectDays}" Minimum="0" Maximum="2147483647" Width="68"/>
                                                                <TextBlock Text="day" VerticalAlignment="Center" Margin="3,0,8,0"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                                <xctk:IntegerUpDown MinHeight="34" Value="{Binding Switch2AutoDisconnectHours}" Minimum="0" Maximum="23" Width="55"/>
                                                                <TextBlock Text="hour" VerticalAlignment="Center" Margin="3,0,8,0"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                                <xctk:IntegerUpDown MinHeight="34" Value="{Binding Switch2AutoDisconnectMinutes}" Minimum="0" Maximum="59" Width="55"/>
                                                                <TextBlock Text="minute" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                            </StackPanel>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </WrapPanel>
                                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="Set the duration to zero to disable the timer. Until changed here, existing profiles keep their Idle Disconnect setting." Foreground="{DynamicResource MutedForegroundColor}"/>
                                            </StackPanel>
                                        </GroupBox>
                                        <CheckBox IsChecked="{Binding Switch2ConnectionHapticEnabled}" Margin="0,7,0,0" Content="Vibrate when connected" ToolTip="Play a short vibration when the controller is ready."/>
                                    </StackPanel>
                                </Expander>
                            </Border>
                            <Border Style="{StaticResource Switch2SettingsCardStyle}">
                                <Expander x:Name="switch2CalibrationCard" IsExpanded="false" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Correct drift &amp; stick range">
                                    <Expander.Header>
                                        <DockPanel LastChildFill="True" Margin="4,0,0,0">
                                            <Image Source="{x:Static local:Switch2FeatureArtwork.Calibration}" Width="64" Height="44" Stretch="Uniform" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Correct drift &amp; stick range" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Use guided calibration if a stick feels off or the aim drifts." Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="24,10,0,0">
                                        <GroupBox Header="Stick calibration" Padding="8,6" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap" Text="Follow the guided steps to correct stick centers and range. Factory settings stay unchanged." Foreground="{DynamicResource MutedForegroundColor}"/>
                                                <Button Content="Calibrate sticks…" Click="Switch2StickCalibration_Click" HorizontalAlignment="Left" Margin="0,7,0,0" Padding="10,4"/>
                                            </StackPanel>
                                        </GroupBox>
                                        <StackPanel Margin="20,5,0,2">
                                            <TextBlock TextWrapping="Wrap" Text="Place the controller on a stable surface and leave it still for at least five seconds after starting." Foreground="{DynamicResource MutedForegroundColor}"/>
                                            <Button Content="Restart gyro calibration" Click="GyroCalibration_Click" HorizontalAlignment="Left" Margin="0,5,0,0" Padding="8,3" ToolTip="Correct gyro drift. Keep the controller still for at least five seconds."/>
                                        </StackPanel>
                                        <StackPanel Margin="20,5,0,2">
                                            <TextBlock TextWrapping="Wrap" Text="Slowly rotate the controller in a figure-eight. Game input pauses during calibration." Foreground="{DynamicResource MutedForegroundColor}"/>
                                            <WrapPanel Margin="0,0,0,4">
                                                <Button x:Name="Switch2MagnetometerCalibrationButton" Content="Calibrate drift correction" Click="Switch2MagnetometerCalibration_Click" Padding="8,3" Margin="0,0,8,8"/>
                                                <Button x:Name="Switch2MagnetometerCalibrationCancelButton" Content="Cancel" Click="Switch2MagnetometerCalibrationCancel_Click" Visibility="Collapsed" Margin="0,0,8,8" Padding="8,3"/>
                                            </WrapPanel>
                                            <TextBlock x:Name="Switch2MagnetometerCalibrationStatus" Margin="0,4,0,0" TextWrapping="Wrap" Text="Use this if sideways drift correction feels inaccurate." Foreground="{DynamicResource MutedForegroundColor}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced" Tag="Output device, rumble, audio, latency, compatibility, and custom hooks">
                <Grid>
                    <Grid.Resources>
                        <DataTemplate x:Key="ProfileAdvancedCheckContentTemplate">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,12">
                        <RadioButton Content="Output" GroupName="ProfileAdvancedCategory" Style="{DynamicResource BridgeSettingsCategoryStyle}" IsChecked="True" x:Name="profileAdvancedOutputNav"/>
                        <RadioButton Content="Feedback" GroupName="ProfileAdvancedCategory" Style="{DynamicResource BridgeSettingsCategoryStyle}" IsChecked="False" x:Name="profileAdvancedFeedbackNav"/>
                        <RadioButton Content="Audio" IsEnabled="{Binding ShowPlayStationControllerSettings}" ToolTip="Controller audio options are available for PlayStation controllers." GroupName="ProfileAdvancedCategory" Style="{DynamicResource BridgeSettingsCategoryStyle}" IsChecked="False" x:Name="profileAdvancedAudioNav"/>
                        <RadioButton Content="Input" GroupName="ProfileAdvancedCategory" Style="{DynamicResource BridgeSettingsCategoryStyle}" IsChecked="False" x:Name="profileAdvancedInputNav"/>
                        <RadioButton Content="Connection" GroupName="ProfileAdvancedCategory" Style="{DynamicResource BridgeSettingsCategoryStyle}" IsChecked="False" x:Name="profileAdvancedConnectionNav"/>
                    </WrapPanel>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsChecked, ElementName=profileAdvancedOutputNav, Converter={StaticResource BooleanToVisibilityConverter}}">
