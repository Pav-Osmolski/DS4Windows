<Window x:Class="DS4WinWPF.DS4Forms.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        Title="{lex:LocExtension HotkeysAbout}" Width="960" Height="780"
        MinWidth="620" MinHeight="480" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Style="{DynamicResource WindowStyle}">
    <Window.Resources>
        <BitmapImage x:Key="AboutBanner" UriSource="/DS4Windows;component/Resources/About/about-banner.png"/>
        <Style x:Key="AboutBody" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="AboutDescription" TargetType="TextBlock" BasedOn="{StaticResource AboutBody}">
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}"/>
        </Style>
        <Style x:Key="AboutHeading" TargetType="TextBlock" BasedOn="{StaticResource AboutBody}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="AboutCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="AboutLinkButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource NavigationSelectionColor}"/>
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource NavigationSelectionColor}"/>
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AboutTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderColor}"
                                Background="{DynamicResource CardBackgroundColor}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource RaisedBackgroundColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource NavigationSelectionColor}"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AboutTabs" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource AboutTab}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                                <WrapPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent" Margin="0,16,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="aboutRoot" Margin="24,20,24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Hotkeys &amp; About" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundColor}"/>
                <TextBlock Text="Help, shortcuts and project information." Style="{StaticResource AboutDescription}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="6" Padding="12,7" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock x:Name="versionText" Style="{StaticResource AboutBody}" FontWeight="SemiBold"/>
            </Border>
        </Grid>
        <TabControl x:Name="aboutTabs" Grid.Row="1" Style="{StaticResource AboutTabs}" SelectedIndex="0" SelectionChanged="AboutTabs_SelectionChanged">
            <TabItem Header="_About">
                <ScrollViewer x:Name="aboutScroll" Focusable="True" IsTabStop="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                    <StackPanel>
                        <Border x:Name="aboutHero" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,20">
                            <Border.Background><ImageBrush ImageSource="{StaticResource AboutBanner}" Stretch="UniformToFill"/></Border.Background>
                            <Grid MinHeight="160" ClipToBounds="True">
                                <Image Source="{StaticResource AboutBanner}" Stretch="Uniform" Visibility="Hidden" IsHitTestVisible="False"/>
                                <StackPanel Margin="26,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="330">
                                    <TextBlock Text="DS4Windows" Foreground="#F4F7FF" FontSize="36" FontWeight="Bold"/>
                                    <TextBlock Text="Your controller. Your way." Foreground="#79C7FF" FontSize="18" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock Text="Remapping · Haptics · Gyro" Foreground="#D0DDF0" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource AboutCard}">
                            <StackPanel>
                                <TextBlock Text="Make your controller feel at home on Windows." Style="{StaticResource AboutHeading}"/>
                                <TextBlock Text="Remap controls, fine-tune gyro aiming and feedback, and create profiles for the games you play. Available features depend on your controller, connection and game." Style="{StaticResource AboutDescription}"/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Content="Website" Tag="https://pav-osmolski.github.io/DS4Windows/" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                    <Button Content="Getting started" Tag="https://pav-osmolski.github.io/DS4Windows/docs/getting-started/" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                    <Button Content="Report an issue" Tag="https://github.com/Pav-Osmolski/DS4Windows/issues/new/choose" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AboutCard}">
                            <StackPanel>
                                <TextBlock Text="Free, open source and actively maintained." Style="{StaticResource AboutHeading}"/>
                                <TextBlock Text="This independent fork is maintained by Pav-Osmolski and continues the work of hbashton and the wider DS4Windows community. Read the Credits and License tabs for the people and projects behind it." Style="{StaticResource AboutDescription}"/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Content="Source code" Tag="https://github.com/Pav-Osmolski/DS4Windows" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                    <Button Content="Release notes" Tag="https://github.com/Pav-Osmolski/DS4Windows/releases" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                    <Button Content="Support development" Tag="https://ko-fi.com/devilhood42" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                </WrapPanel>
                                <TextBlock Text="Support is entirely optional. DS4Windows remains free and open source." Style="{StaticResource AboutDescription}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="_Hotkeys">
                <ScrollViewer x:Name="hotkeysScroll" Focusable="True" IsTabStop="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Shortcuts and gestures" Style="{StaticResource AboutHeading}"/>
                        <TextBlock Text="Shortcuts depend on your controller and active profile. Enable optional gestures in the Profile Editor and check Special Actions for your own button combinations." Style="{StaticResource AboutDescription}" Margin="0,0,0,18"/>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="Connection and touchpad mouse" Style="{StaticResource AboutHeading}" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="PS + Options" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Disconnect Bluetooth when the Disconnect Controller Special Action is configured and enabled." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Hold PS" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Switch off supported PlayStation controllers by holding PS until their lights go out. This is the controller's own power shortcut." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Touchpad + PS" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Toggle touchpad pointer movement in mouse mode. Touchpad clicks continue working." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Two fingers up / down" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Scroll when two-finger scrolling is enabled in the touchpad settings." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Tap, then hold" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Drag with the left mouse button when tap-to-drag is enabled." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Lower-right touchpad click" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Right-click when the lower-right click option is enabled." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Two-finger swipe left / right" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Cycle profiles when touchpad profile swiping is enabled in Settings &gt; Controllers." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                        </StackPanel></Border>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="Touchpad mapping regions" Style="{StaticResource AboutHeading}" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Left Touch / Right Touch" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Click the left or right side of the touchpad to activate its assigned binding." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Multitouch" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Click the touchpad with two fingers to activate the multitouch binding." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Upper Touch" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Click the upper part of the touchpad to activate its assigned binding." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                        </StackPanel></Border>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="Keyboard, mouse and secondary bindings" Style="{StaticResource AboutHeading}" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Shift Modifier" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Hold an assigned control to use its secondary set of bindings." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Toggle" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Keep a mapped key held until you press its assigned control again." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Macro" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Assign a recorded sequence of actions to a controller input." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Text="Scan Code" Style="{StaticResource AboutBody}" FontWeight="SemiBold" MaxWidth="168"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Send keyboard scan codes for applications that need them. Choose this in the binding editor." Style="{StaticResource AboutBody}" Margin="0,5,0,0"/>
                            </Grid>
                        </StackPanel></Border>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="Seeing duplicate input?" Style="{StaticResource AboutHeading}"/>
                            <TextBlock Text="HidHide can hide the physical controller from games while allowing DS4Windows to read it. Avoid overlapping remapping for the same game." Style="{StaticResource AboutDescription}"/>
                            <WrapPanel Margin="0,12,0,0"><Button Content="Open troubleshooting guide" Tag="https://pav-osmolski.github.io/DS4Windows/docs/troubleshooting/" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/></WrapPanel>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="_Credits">
                <ScrollViewer x:Name="creditsScroll" Focusable="True" IsTabStop="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Built on a community's work." Style="{StaticResource AboutHeading}"/>
                        <TextBlock Text="Thank you to the maintainers, contributors, researchers and users who have helped DS4Windows and its supporting projects grow." Style="{StaticResource AboutDescription}" Margin="0,0,0,18"/>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="DS4Windows and its origins" Style="{StaticResource AboutHeading}"/>
                            <TextBlock Text="This fork builds on hbashton's DS4Windows and the wider community, including work by Schmaldeo, Ryochan7 and Jays2Kings. Its history also includes InhexSTER's DS4Tool and electrobrains' early branch. Upstream contributions retain their attribution." Style="{StaticResource AboutDescription}"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="hbashton" Tag="https://github.com/hbashton/DS4Windows" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                <Button Content="Schmaldeo" Tag="https://github.com/schmaldeo" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                <Button Content="Ryochan7" Tag="https://github.com/Ryochan7" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                <Button Content="Jays2Kings" Tag="https://github.com/Jays2Kings" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                <Button Content="InhexSTER / DS4Tool" Tag="https://code.google.com/p/ds4-tool/" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                <Button Content="electrobrains" Tag="https://code.google.com/r/brianfundakowskifeldman-ds4windows/" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                <Button Content="All contributors" Tag="https://github.com/Pav-Osmolski/DS4Windows/blob/main/contributors.md" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                            </WrapPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="Special appreciation for Nefarius" Style="{StaticResource AboutHeading}"/>
                            <TextBlock Text="Nefarius made foundational contributions to Windows controller software, including ViGEm, which powered earlier DS4Windows versions, and HidHide, which helps prevent double input in this fork. This fork now uses VIIPER for virtual-controller output, while continuing to benefit from the wider ecosystem he helped build." Style="{StaticResource AboutDescription}"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="Nefarius and his projects" Tag="https://github.com/nefarius" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                                <Button Content="Support his projects" Tag="https://docs.nefarius.at/Donations/" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/>
                            </WrapPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="Reports, research and testing" Style="{StaticResource AboutHeading}"/>
                            <TextBlock Text="Controller research, bug reports, translations, shared logs and real-world testing all help improve this project. Thank you to everyone contributing their time and experience." Style="{StaticResource AboutDescription}"/>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="_License">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="GNU General Public License v3" Style="{StaticResource AboutHeading}"/>
                        <TextBlock Text="DS4Windows is free and open source software. The full licence is included below; dependency notices are available in Extras." Style="{StaticResource AboutDescription}"/>
                    </StackPanel>
                    <TextBox x:Name="licenseText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" Padding="16"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
                             BorderBrush="{DynamicResource BorderColor}" FontFamily="Consolas" FontSize="12"
                             AutomationProperties.Name="GNU General Public License version 3"/>
                </Grid>
            </TabItem>
            <TabItem Header="_Extras">
                <ScrollViewer x:Name="extrasScroll" Focusable="True" IsTabStop="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Supporting projects and libraries" Style="{StaticResource AboutHeading}"/>
                        <TextBlock Text="These projects help power DS4Windows. Install or repair bundled components through Setup or Settings so their versions stay matched." Style="{StaticResource AboutDescription}" Margin="0,0,0,18"/>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="VIIPER" Style="{StaticResource AboutHeading}"/>
                            <TextBlock Text="The virtual-controller backend bundled with this fork. Use the matching version supplied with DS4Windows." Style="{StaticResource AboutDescription}"/>
                            <WrapPanel Margin="0,12,0,0"><Button Content="Project page" Tag="https://github.com/Pav-Osmolski/VIIPER" Style="{StaticResource AboutLinkButton}" Click="Link_Click" AutomationProperties.Name="VIIPER project page"/></WrapPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="usbip-win2" Style="{StaticResource AboutHeading}"/>
                            <TextBlock Text="The USB/IP driver stack used by the backend. Use Setup to install, update or repair the supported package." Style="{StaticResource AboutDescription}"/>
                            <WrapPanel Margin="0,12,0,0"><Button Content="Project page" Tag="https://github.com/vadimgrn/usbip-win2" Style="{StaticResource AboutLinkButton}" Click="Link_Click" AutomationProperties.Name="usbip-win2 project page"/></WrapPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="HidHide" Style="{StaticResource AboutHeading}"/>
                            <TextBlock Text="Hides selected physical controllers from games to help prevent duplicate input. DS4Windows must remain allowed to access them." Style="{StaticResource AboutDescription}"/>
