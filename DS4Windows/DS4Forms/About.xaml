                            <WrapPanel Margin="0,12,0,0"><Button Content="Project page" Tag="https://github.com/HavenDV/H.NotifyIcon/" Style="{StaticResource AboutLinkButton}" Click="Link_Click" AutomationProperties.Name="H.NotifyIcon project page"/></WrapPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="vJoyInterfaceCS" Style="{StaticResource AboutHeading}"/>
                            <TextBlock Text="Interface library from the vJoy project." Style="{StaticResource AboutDescription}"/>
                            <WrapPanel Margin="0,12,0,0"><Button Content="Project page" Tag="https://github.com/shauleiz/vJoy/tree/master/apps/common/vJoyInterfaceCS" Style="{StaticResource AboutLinkButton}" Click="Link_Click" AutomationProperties.Name="vJoyInterfaceCS project page"/></WrapPanel>
                        </StackPanel></Border>
                        <WrapPanel><Button Content="Full dependency notices" Tag="https://github.com/Pav-Osmolski/DS4Windows/blob/main/NOTICE.txt" Style="{StaticResource AboutLinkButton}" Click="Link_Click"/></WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
            <Button Content="Close" Style="{StaticResource AboutLinkButton}" Margin="0" MinWidth="90" Padding="18,7" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
