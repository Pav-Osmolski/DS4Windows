                        </StackPanel></Border>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="One Euro Filter" Style="{StaticResource AboutHeading}"/>
                            <TextBlock Text="Adaptive smoothing for motion data." Style="{StaticResource AboutDescription}"/>
                            <WrapPanel Margin="0,12,0,0"><Button Content="Project page" Tag="https://gery.casiez.net/1euro/" Style="{StaticResource AboutLinkButton}" Click="Link_Click" AutomationProperties.Name="One Euro Filter project page"/></WrapPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource AboutCard}"><StackPanel>
                            <TextBlock Text="H.NotifyIcon" Style="{StaticResource AboutHeading}"/>
