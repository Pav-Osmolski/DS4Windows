<UserControl x:Class="DS4WinWPF.DS4Forms.AutoProfiles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture=""
             lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
             xmlns:entity="clr-namespace:DS4WinWPF"
             mc:Ignorable="d" 
             d:DesignHeight="380" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="AutoProfileToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource BridgeSecondaryButtonStyle}">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <Style x:Key="AutoProfileMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemChrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource NavigationSelectionColor}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="AutoProfileMenuStyle" TargetType="ContextMenu">
            <Style.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource AutoProfileMenuItemStyle}"/>
                <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource MenuSeparatorColor}"/></ControlTemplate></Setter.Value></Setter>
                </Style>
            </Style.Resources>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>

            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <Style x:Key="AutoProfileRuleItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RuleCard" Background="{DynamicResource CardBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="5" Padding="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RuleCard" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RuleCard" Property="Background" Value="{DynamicResource NavigationSelectionColor}" />
                                <Setter TargetName="RuleCard" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AutoProfileMetaLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,1,10,1" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="AutoProfileMetaValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="0,2,0,0">
            <Border DockPanel.Dock="Right" Width="304" Margin="12,0,0,0"
                    Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="5" Padding="12">
            <ScrollViewer x:Name="sidebarScrollViewer" Style="{StaticResource BridgeDropDownScrollViewerStyle}" CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Thickness x:Key="spaceMargin" Bottom="8" />
                </ScrollViewer.Resources>
                <StackPanel x:Name="outerEditControlsPanel" Margin="0,0,8,0">
                    <StackPanel.Resources>
                        <CollectionViewSource x:Key="profileCollection" Source="{Binding ProfileList.ProfileListCol,Mode=OneWay}" />
                    </StackPanel.Resources>

                    <TextBlock Text="{lex:Loc Strings:UI_D9A387F19034F499}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundColor}" Margin="0,0,0,12"/>
                    <StackPanel x:Name="editControlsPanel" IsEnabled="False">
                        <UniformGrid Columns="3" Height="34" Margin="0,0,0,10">
                            <Button x:Name="removeAutoBtn" Content="{lex:Loc Strings:UI_E2D0A54968EAD24E}" Margin="0,0,6,0"
                                    ToolTip="{lex:Loc Strings:UI_064606C4AF0F2BEB}" Click="RemoveAutoBtn_Click" />
                            <Button x:Name="duplicateAutoBtn" Content="{lex:Loc Strings:UI_02CDAABFCA805D6A}" Margin="0,0,6,0" Click="DuplicateAutoBtn_Click" />
                            <Button x:Name="saveAutoBtn" Content="{lex:Loc Strings:UI_4E62C225ADB2E2AA}" Click="SaveAutoBtn_Click" />
                        </UniformGrid>
                        <CheckBox Content="{lex:Loc Strings:UI_57993E10706C49EB}" IsChecked="{Binding Enabled}" Margin="0,0,0,8"/>
                        <TextBlock Text="{lex:Loc Strings:UI_0AF7A2AC67B38866}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,12"/>
                        <Grid x:Name="autoProfilesGrid" Margin="0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="{StaticResource spaceMargin}">
                                <Label Content="{lex:Loc Controller1Text}" Padding="0" VerticalAlignment="Center" />
                                <CheckBox Content="{lex:Loc Strings:UI_A52ACE420F2175D0}" Margin="10,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding ApplyToAllControllers}" />
                            </StackPanel>
                            <ComboBox x:Name="cont1AutoProf" Grid.Column="1" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon1}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Strings:UI_552E423045FCBD94}"/>
                                        <CollectionContainer x:Name="cont1AutoProfCol" Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                            <Label Content="{lex:Loc Controller2Text}" Grid.Row="1" Margin="{StaticResource spaceMargin}"
                                   Visibility="{Binding ControllerSpecificProfilesVisible}" />
                            <ComboBox x:Name="cont2AutoProf" Grid.Row="1" Grid.Column="1" Margin="{StaticResource spaceMargin}"
                              Visibility="{Binding ControllerSpecificProfilesVisible}"
                              SelectedIndex="{Binding SelectedIndexCon2}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Strings:UI_552E423045FCBD94}"/>
                                        <CollectionContainer x:Name="cont2AutoProfCol" Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                            <Label Content="{lex:Loc Controller3Text}" Grid.Row="2" Margin="{StaticResource spaceMargin}"
                                   Visibility="{Binding ControllerSpecificProfilesVisible}" />
                            <ComboBox x:Name="cont3AutoProf" Grid.Row="2" Grid.Column="1" Margin="{StaticResource spaceMargin}"
                              Visibility="{Binding ControllerSpecificProfilesVisible}"
                              SelectedIndex="{Binding SelectedIndexCon3}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Strings:UI_552E423045FCBD94}"/>
                                        <CollectionContainer x:Name="cont3AutoProfCol" Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                            <Label Content="{lex:Loc Controller4Text}" Grid.Row="3" Margin="{StaticResource spaceMargin}"
                                   Visibility="{Binding ControllerSpecificProfilesVisible}" />
                            <ComboBox x:Name="cont4AutoProf" Grid.Row="3" Grid.Column="1" Margin="{StaticResource spaceMargin}"
                              Visibility="{Binding ControllerSpecificProfilesVisible}"
                              SelectedIndex="{Binding SelectedIndexCon4}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Strings:UI_552E423045FCBD94}"/>
                                        <CollectionContainer x:Name="cont4AutoProfCol" Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                        <Label Content="{lex:Loc Controller5Text}" Grid.Row="4" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}" />
                        <ComboBox x:Name="cont5AutoProf" Grid.Row="4" Grid.Column="1" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon5}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Strings:UI_552E423045FCBD94}"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                        <Label Content="{lex:Loc Controller6Text}" Grid.Row="5" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}" />
                        <ComboBox x:Name="cont6AutoProf" Grid.Row="5" Grid.Column="1" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon6}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Strings:UI_552E423045FCBD94}"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>


                        <Label Content="{lex:Loc Controller7Text}" Grid.Row="6" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}" />
                        <ComboBox x:Name="cont7AutoProf" Grid.Row="6" Grid.Column="1" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon7}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Strings:UI_552E423045FCBD94}"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                        <Label Content="{lex:Loc Controller8Text}" Grid.Row="7" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}" />
                        <ComboBox x:Name="cont8AutoProf" Grid.Row="7" Grid.Column="1" Visibility="{Binding ExpandedControllerSpecificProfilesVisible}" Margin="{StaticResource spaceMargin}"
                              SelectedIndex="{Binding SelectedIndexCon8}">
                                <ComboBox.Resources>
                                    <DataTemplate DataType="{x:Type ComboBoxItem}">
                                        <TextBlock Text="{Binding Content}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type entity:ProfileEntity}">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.Resources>
                                <ComboBox.ItemsSource>
                                    <CompositeCollection>
                                        <ComboBoxItem Content="{lex:Loc Strings:UI_552E423045FCBD94}"/>
                                        <CollectionContainer Collection="{Binding Source={StaticResource profileCollection}}" />
                                    </CompositeCollection>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </Grid>

                    <CheckBox Margin="{StaticResource spaceMargin}" IsChecked="{Binding Turnoff}">
                        <TextBlock Text="{lex:Loc TurnOffDS4WindowsTemporarily}" TextWrapping="Wrap" />
                    </CheckBox>
                        <Grid Margin="{StaticResource spaceMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Content="{lex:Loc Strings:UI_6BA0BDECCB426D7B}" Padding="0" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.DeviceOptionList, ElementName=outerEditControlsPanel}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="ChoiceValue"
                                      SelectedValue="{Binding DeviceOption}" />
                        </Grid>
                        <TextBlock Text="{lex:Loc Strings:UI_232A4A0F585E2AA1}" Foreground="{DynamicResource MutedForegroundColor}" FontSize="12" Margin="0,4,0,4"/>
                        <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource spaceMargin}" ToolTip="{lex:Loc AutoProfPathTip}"
                                 TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" MaxHeight="90"/>

                        <TextBlock Text="{lex:Loc Strings:UI_534837B3B824387D}" Foreground="{DynamicResource MutedForegroundColor}" FontSize="12" Margin="0,4,0,4"/>
                        <Grid x:Name="ruleTitleField" Margin="0">
                            <TextBox x:Name="mainTxtBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" ToolTip="{lex:Loc AutoProfTitleTip}" />

                            <TextBlock Margin="7,0" VerticalAlignment="Center" MinWidth="50" Text="{lex:Loc Strings:UI_E1567DADDDA59464}" Foreground="{DynamicResource ForegroundColor}" Opacity="0.7" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=mainTxtBox, Path=Text.IsEmpty, Mode=OneWay}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ElementName=mainTxtBox, Path=Text.IsEmpty, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </Grid>

                    </StackPanel>
                <Border x:Name="ruleOptionsDivider" Height="1" Background="{DynamicResource BorderColor}" Margin="0,16" SnapsToDevicePixels="True"/>
                <CheckBox x:Name="revertDefaultProfileOnUnknownCk" Margin="0" IsChecked="{Binding RevertDefaultProfileOnUnknown}">
                    <TextBlock Text="{lex:Loc RevertToDefaultProfileOnUnknown}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox x:Name="showAutoDebugCk" Margin="0,10,0,0" Click="ShowAutoDebugCk_Click">
                    <TextBlock Text="{lex:Loc ShowAutoProfileDebugMessages}" TextWrapping="Wrap" />
                </CheckBox>
                <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                    <TextBlock Text="{lex:Loc AutoProfiles.DisplaySwitchVia}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding DisplayProfileSwitchList}" DisplayMemberPath="DisplayName" SelectedValuePath="ChoiceValue"
                              SelectedValue="{Binding ProfileSwitchChoice}" />
                </StackPanel>

            </StackPanel>
            </ScrollViewer>
            </Border>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{lex:Loc Strings:UI_12A8368DDC6AB065}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundColor}"/>
                <TextBlock Text="{lex:Loc Strings:UI_0E26CF3AB2092F53}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,6,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Top" Width="390" MaxWidth="390"
                    HorizontalAlignment="Left" Margin="0,0,0,10"
                    Background="{DynamicResource RaisedBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons"
                               Foreground="{DynamicResource MutedForegroundColor}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox x:Name="autoProfilesSearchTextBox" Grid.Column="1"
                             Style="{DynamicResource BridgeSearchTextBoxStyle}"
                             TextChanged="AutoProfilesSearchTextBox_TextChanged"
                             ToolTip="{lex:Loc Strings:UI_B8C5A26D50EC2E90}" />
                    <Button x:Name="clearAutoProfilesSearchBtn" Grid.Column="2" Content="&#xE711;"
                            FontFamily="Segoe Fluent Icons" FontSize="11"
                            Background="Transparent" BorderThickness="0"
                            Visibility="Collapsed" ToolTip="{lex:Loc Strings:UI_3B7EA51793E9D906}"
                            Click="ClearAutoProfilesSearchBtn_Click" />
                </Grid>
            </Border>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button x:Name="addProgramsBtn" Content="{lex:Loc AddPrograms}" Click="AddProgramsBtn_Click"
                        Style="{StaticResource AutoProfileToolbarButtonStyle}">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource AutoProfileMenuStyle}" Placement="Bottom">
                            <MenuItem x:Name="steamMenuItem" Header="{lex:Loc AddSteamGames}" Click="SteamMenuItem_Click" />
                            <MenuItem x:Name="startMenuItem" Header="{lex:Loc AddStartMenuPrograms}" Click="StartMenuItem_Click" />
                            <MenuItem x:Name="browseProgsMenuItem" Header="{lex:Loc AddDirectory}" Click="BrowseProgsMenuItem_Click" />
                            <MenuItem x:Name="browseAddProgMenuItem" Header="{lex:Loc BrowseOtherPrograms}" Click="BrowseAddProgMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="windowTitleRuleMenuItem" Header="{lex:Loc AddWindowTitleRule}" Click="WindowTitleRuleMenuItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="hideUncheckedBtn" Content="{lex:Loc Strings:UI_48B4990A496045D5}" Click="HideUncheckedBtn_Click"
                        Style="{StaticResource AutoProfileToolbarButtonStyle}" ToolTip="{lex:Loc Strings:UI_E2A091C4B37E0D7C}"/>
                <Button x:Name="moveRuleUpBtn" Content="{lex:Loc Strings:UI_C66FEB5EB8F217C7}" Click="MoveUpDownAutoBtn_Click" IsEnabled="False"
                        Style="{StaticResource AutoProfileToolbarButtonStyle}" ToolTip="{lex:Loc Strings:UI_97AB945C87A40F90}"/>
                <Button x:Name="moveRuleDownBtn" Content="{lex:Loc Strings:UI_40BB50DA160CDC21}" Click="MoveUpDownAutoBtn_Click" IsEnabled="False"
                        Style="{StaticResource AutoProfileToolbarButtonStyle}" Margin="0,0,0,6" ToolTip="{lex:Loc Strings:UI_D065DC63CFA2371E}"/>
            </WrapPanel>
            <Border x:Name="scanStatusPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,12" Padding="12"
                    Background="{DynamicResource RaisedBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="cancelScanBtn" Content="{lex:Loc Strings:UI_19766ED6CCB2F4A3}" Visibility="Collapsed" DockPanel.Dock="Right" Click="CancelScanBtn_Click" Style="{StaticResource BridgeSecondaryButtonStyle}" MinWidth="68" Padding="8,4" Margin="12,0,0,0"/>
                        <TextBlock x:Name="scanStatusText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}" AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>
                    <TextBlock x:Name="scanLocationText" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap" MaxHeight="60" Margin="0,6,0,0"/>
                    <ProgressBar x:Name="scanProgress" Visibility="Collapsed" IsIndeterminate="True" Foreground="{DynamicResource AccentColor}" Background="{DynamicResource BorderColor}" Height="4" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <ListView x:Name="programListLV" SelectionMode="Single" PreviewMouseDown="ProgramListLV_PreviewMouseDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                      SelectedIndex="{Binding SelectedIndex}" SelectedItem="{Binding SelectedItem}"
                      ItemContainerStyle="{StaticResource AutoProfileRuleItemStyle}"
                      Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource RaisedBackgroundColor}" CornerRadius="4" Padding="7,4" VerticalAlignment="Top" Margin="0,0,12,0">
                                <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource ForegroundColor}"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="28" Height="28" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Exeicon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding Exeicon}" Stretch="Uniform"/>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Filename}" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Filename}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{lex:Loc Path}" Style="{StaticResource AutoProfileMetaLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" ToolTip="{Binding Path}"
                                               Style="{StaticResource AutoProfileMetaValueStyle}" />
