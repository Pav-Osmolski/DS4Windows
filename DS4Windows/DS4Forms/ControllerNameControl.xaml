<UserControl x:Class="DS4WinWPF.DS4Forms.ControllerNameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="RenameControllerButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <TextBlock x:Name="nameDisplay" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                   HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}">
            <Run Text="{Binding ControllerDisplayName, Mode=OneWay}"/><Run Text=" "/>
            <InlineUIContainer BaselineAlignment="Center">
                <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="displayIdentity" Text="{Binding ControllerIdentityText}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center"/>
                <Button x:Name="renameButton" Style="{StaticResource RenameControllerButton}"
                        IsEnabled="{Binding CanRenameController}" Click="Rename_Click">
                    <Path Data="M3,11 L3,15 L7,15 L15,7 L11,3 Z M10,4 L14,8" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" StrokeLineJoin="Round"/>
                </Button>
                </StackPanel>
            </InlineUIContainer>
            <TextBlock.ToolTip>
                <StackPanel>
                    <TextBlock Text="{Binding IdText}" MaxWidth="450" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding TooltipIDText}"/>
                </StackPanel>
            </TextBlock.ToolTip>
        </TextBlock>
        <StackPanel x:Name="editorPanel" Visibility="Collapsed">
            <TextBox x:Name="nameEditor" FontSize="15" Padding="5,3" MinHeight="28"
                     Foreground="{DynamicResource ForegroundColor}" Background="{DynamicResource CardBackgroundColor}"
                     BorderBrush="{DynamicResource BorderColor}" CaretBrush="{DynamicResource ForegroundColor}"
                     PreviewTextInput="Editor_PreviewTextInput" PreviewKeyDown="Editor_PreviewKeyDown"
                     TextChanged="Editor_TextChanged"/>
            <TextBlock Text="{Binding ControllerIdentityText}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundColor}" TextWrapping="Wrap" Margin="0,2,0,0"
                       ToolTip="{Binding IdText}"/>
            <TextBlock x:Name="renameError" Foreground="{DynamicResource DangerColor}" TextWrapping="Wrap"
                       FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
